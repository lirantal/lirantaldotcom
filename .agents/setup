#!/usr/bin/env bash
# Prepares an Amp orb to build and run this Astro site. Idempotent; safe on a warm snapshot.
set -euo pipefail

cd "$(dirname "$0")/.."

step() { printf '\n==> %s\n' "$*"; }
SECONDS=0

# package.json engines (with engine-strict=true in .npmrc) require npm >= 11.10, which also
# enforces the min-release-age policy in .npmrc. Upgrade npm only when the orb's is older.
step "npm $(npm --version)"
if ! node -e 'const [a, b] = process.argv[1].split(".").map(Number); process.exit(a > 11 || (a === 11 && b >= 10) ? 0 : 1)' "$(npm --version)"; then
	step "Installing npm 11 (need >= 11.10)"
	(cd /tmp && npm install --global --no-audit --no-fund 'npm@^11.10.0')
	hash -r
	step "npm $(npm --version)"
fi

# No lockfile is committed (package-lock.json is gitignored); a warm node_modules makes this fast.
step "Installing dependencies"
npm install --no-audit --no-fund

step "Setup finished in ${SECONDS}s"
