#!/usr/bin/env bash
# Prepares an Amp orb to build and run this Astro site. Idempotent; safe on a warm snapshot.
set -euo pipefail

cd "$(dirname "$0")/.."

step() { printf '\n==> %s\n' "$*"; }
SECONDS=0

# Use the same exact npm pin and project security policies as CI.
bash .github/scripts/setup-npm.sh
hash -r

# No lockfile is committed (package-lock.json is gitignored); a warm node_modules makes this fast.
step "Installing dependencies"
npm install --no-audit --no-fund

step "Setup finished in ${SECONDS}s"
