---
import Layout from '~/layouts/SpeakingLayout.astro';
import PageIntro from '~/components/speaking/PageIntro.astro';
import VideoCard from '~/components/speaking/VideoCard.astro';
import Filters from '~/components/speaking/Filters.astro';

import { getCanonical } from '~/utils/permalinks';
import { TYPES, getSpeaking } from '~/utils/speaking';

const { videos } = await getSpeaking();

const videoYears = [...new Set(videos.map((e) => e.year))];
const videoTypes = Object.keys(TYPES)
	.map((type) => ({ value: type, label: TYPES[type].label, count: videos.filter((e) => e.type === type).length }))
	.filter((t) => t.count);
const languages = [...new Set(videos.map((e) => e.language))].map((language) => ({
	value: language,
	label: language,
	count: videos.filter((e) => e.language === language).length,
}));

const meta = {
	title: 'Recordings: watch talks by Liran Tal',
	description: `${videos.length} recorded conference talks, meetups, webinars and podcast episodes by Liran Tal on AI security, supply chain security and Node.js security.`,
	canonical: getCanonical(Astro.url.pathname),
};
---

<Layout {meta}>
	<PageIntro
		eyebrow="Speaking · Recordings"
		title={`${videos.length} recordings,`}
		highlight="ready to watch."
		description="Conference talks, meetup sessions, livestreams and video podcasts, newest first. Pick one to watch it here, along with the slides and photos from that event."
	/>

	<section class="max-w-6xl mx-auto px-4 sm:px-6 pb-8">
		<Filters
			total={videos.length}
			groups={[
				{ name: 'type', label: 'Type', kind: 'chips', options: videoTypes },
				{ name: 'language', label: 'All languages', kind: 'select', options: languages },
			]}
		/>
		{
			videoYears.map((year) => (
				<div data-filter-section class="mt-10">
					<h2 class="text-2xl font-bold font-heading border-b border-gray-200 dark:border-slate-800 pb-2 mb-6">
						{year}
					</h2>
					<ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
						{videos
							.filter((e) => e.year === year)
							.map((event) => (
								<VideoCard event={event} data-filter-item data-type={event.type} data-language={event.language} />
							))}
					</ul>
				</div>
			))
		}
		<p data-filter-empty hidden class="py-16 text-center speaking-muted">No recordings match these filters.</p>
	</section>
</Layout>
