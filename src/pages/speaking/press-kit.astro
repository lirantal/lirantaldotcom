---
import { readFileSync } from 'node:fs';
import { Image } from 'astro:assets';
import Layout from '~/layouts/SpeakingLayout.astro';
import { shortBio } from '~/data/portfolio';
import portrait from '~/assets/images/liran-tal-portrait.jpg';
import { PROFILE } from '~/config.mjs';
import { getCanonical } from '~/utils/permalinks';
import '~/assets/styles/portfolio.css';

// The downloadable text and displayed long bio share one source.
const longBio = readFileSync('public/press/liran-tal-bio.txt', 'utf8')
	.trim()
	.split(/\n\s*\n/);
const meta = {
	title: 'Liran Tal — Speaker Press Kit',
	description: 'Speaker biographies, portrait, links, and topics for event organizers featuring Liran Tal.',
	canonical: getCanonical('/speaking/press-kit'),
};
---

<Layout {meta}>
	<div class="portfolio">
		<header class="page-intro">
			<p class="eyebrow">For event organizers & podcast hosts</p>
			<h1>Speaker press kit.</h1>
			<p>
				A short introduction, the full story, and a portrait for your event page. Looking for a session? <a
					href="/speaking/talks">Browse the talk catalogue</a
				>.
			</p>
		</header>
		<div class="grid md:grid-cols-[2fr_1fr] gap-10 md:gap-16 pb-14">
			<div>
				<section aria-labelledby="short-bio-title" class="surface mb-10">
					<p class="eyebrow">For introductions</p>
					<h2 id="short-bio-title">Short bio</h2>
					<p class="mt-5 select-text max-w-[65ch]">{shortBio}</p>
				</section>
				<section aria-labelledby="full-bio-title">
					<div class="section-heading">
						<h2 id="full-bio-title">Full bio</h2><a href="/press/liran-tal-bio.txt" download="liran-tal-bio.txt"
							>Download bio (.txt) ↓</a
						>
					</div>
					{longBio.map((paragraph) => <p class="muted mb-5 select-text max-w-[65ch]">{paragraph}</p>)}
				</section>
			</div>
			<aside aria-label="Speaker details">
				<Image src={portrait} alt="Portrait of Liran Tal" width={400} height={400} class="rounded-xl w-full max-w-xs" />
				<p class="text-sm mt-4">
					<a href={portrait.src} download="liran-tal-portrait.jpg">Download portrait (.jpg) ↓</a>
				</p>
				<p class="text-xs muted mt-2">The portrait used on this site, in its original square crop.</p>
				<div class="mt-8">
					<h2 class="!text-xl">At a glance</h2>
					<dl class="text-sm mt-4 space-y-4">
						<div><dt class="font-semibold">Name</dt><dd class="muted">Liran Tal</dd></div>
						<div>
							<dt class="font-semibold">Focus</dt><dd class="muted">
								AI & agentic security, Node.js secure coding, software supply chain security
							</dd>
						</div>
						<div><dt class="font-semibold">Languages</dt><dd class="muted">English and Hebrew</dd></div>
					</dl>
					<p class="mt-5 text-sm">
						<a href={PROFILE.linkedinURL}>Contact on LinkedIn <span aria-hidden="true">↗</span></a>
					</p>
					<p class="mt-3 text-sm"><a href={PROFILE.twitterURL}>Contact on X <span aria-hidden="true">↗</span></a></p>
				</div>
			</aside>
		</div>
	</div>
</Layout>
