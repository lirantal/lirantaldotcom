---
/** Vercel + `middlewareMode: 'edge'`: edge middleware does not run for prerendered pages; keep `/` on-demand so `Accept: text/markdown` negotiation in `src/middleware.ts` applies (withastro/astro#10536). */
export const prerender = false;

import { SITE } from '~/config.mjs';
import { getCanonical, getHomePermalink } from '~/utils/permalinks';
import Layout from '~/layouts/PageLayout.astro';

import Features from '~/components/widgets/Features.astro';
import HighlightedPosts from '~/components/blog/HighlightedPosts.astro';
import ProfileHero from '~/components/widgets/ProfileHero.astro';

const meta = {
	title: SITE.title,
	description: SITE.description,
	canonical: getCanonical(getHomePermalink()),
};
---

<Layout {meta}>
	<ProfileHero />
	<Features />
	<HighlightedPosts />

	<!-- 
	<Steps />
	<Features2 />
	<Features3 />
	<FAQs />
	<Stats />
	<CallToAction /> -->
</Layout>
