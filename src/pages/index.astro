---
import { Image } from 'astro:assets';
import { SITE, PROFILE } from '~/config.mjs';
import { getCanonical, getHomePermalink, getPermalink } from '~/utils/permalinks';
import Layout from '~/layouts/PageLayout.astro';
import ProfileHero from '~/components/widgets/ProfileHero.astro';
import Section from '~/components/portfolio/Section.astro';
import PaperList from '~/components/research/PaperList.astro';
import { projects, books, publications } from '~/data/portfolio';
import downloads from '~/data/npm-downloads.json';
import github from '~/data/github-impact.json';
import { community } from '~/data/community';
import ProjectBadges from '~/components/portfolio/ProjectBadges.astro';
import { fetchPosts } from '~/utils/posts';
import { getSpeaking } from '~/utils/speaking';
import speakingImage from '~/assets/images/speaking-hero.jpg';
import '~/assets/styles/portfolio.css';

const posts = (await fetchPosts()).slice(0, 3);
const { stats } = await getSpeaking();
const totalDownloads = downloads.packages.reduce((total, pkg) => total + pkg.downloads, 0);
const downloadLabel = `${(totalDownloads / 1_000_000).toFixed(2)}M`;
const dateLabel = (date: string) =>
	new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const totalStars = github.repositories.reduce((total, repo) => total + repo.stars, 0);
const totalForks = github.repositories.reduce((total, repo) => total + repo.forks, 0);
const meta = {
	title: 'Liran Tal — AI Security Research & Node.js Security',
	description: SITE.description,
	canonical: getCanonical(getHomePermalink()),
};
---

<Layout {meta}>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: SITE.name,
			url: SITE.origin,
			description: SITE.description,
			jobTitle: 'AI security researcher, open-source maintainer, and author',
			sameAs: [PROFILE.githubURL, PROFILE.linkedinURL, PROFILE.twitterURL, PROFILE.mastodonURL],
		})}
	/>
	<div class="portfolio">
		<ProfileHero />
		<section
			class="border-t border-gray-200 dark:border-slate-700 pt-7 pb-10 md:pb-14"
			aria-labelledby="featured-projects-title"
		>
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-6">
				<h2 id="featured-projects-title" class="!text-base !tracking-normal">Tools & resources I maintain</h2>
				<a href="#open-source" class="text-sm">More projects & impact <span aria-hidden="true">→</span></a>
			</div>
			<div class="grid md:grid-cols-3 gap-7 md:gap-10">
				{
					projects
						.filter((project) => ['lockfile-lint', 'npq', 'Node.js CLI Apps Best Practices'].includes(project.name))
						.map((project) => (
							<article>
								<p class="eyebrow">{project.kind}</p>
								<h3>
									<a href={project.url}>
										{project.name} <span aria-hidden="true">↗</span>
									</a>
								</h3>
								<ProjectBadges url={project.url} npm={project.npm} name={project.name} />
								<p class="mt-3 muted text-sm">{project.description}</p>
							</article>
						))
				}
			</div>
		</section>
		<Section id="speaking" number="01" title="Speaking">
			<a slot="link" href="/speaking">Explore talks & events <span aria-hidden="true">→</span></a>
			<div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
				<Image
					src={speakingImage}
					alt="Liran Tal presenting at JSNation US 2025"
					widths={[480, 960]}
					sizes="(max-width: 767px) 100vw, 520px"
					class="rounded-xl aspect-[16/10] w-full object-cover"
				/>
				<div>
					<p class="text-2xl font-semibold tracking-tight">
						{stats.talksDelivered} talks. {stats.countries} countries.<br />Plenty of live hacking.
					</p>
					<p class="muted mt-4">
						I bring real-world attacks and practical defenses to conferences, meetups, and workshops. AI security,
						Node.js, and the software supply chain, explained through code.
					</p>
					<div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm">
						<a href="/speaking/recordings">Watch a talk <span aria-hidden="true">→</span></a><a
							href="/speaking/press-kit">Speaker press kit <span aria-hidden="true">→</span></a
						>
					</div>
				</div>
			</div>
		</Section>
		<Section id="writing" number="02" title="Blog & articles">
			<a slot="link" href="/writing">Blog & publications <span aria-hidden="true">→</span></a>
			<div class="grid md:grid-cols-[2fr_1fr] gap-10 md:gap-16">
				<div>
					{
						posts.map((post) => (
							<article class="editorial-row">
								<p class="text-xs muted mb-2">
									On the blog · <time datetime={new Date(post.pubDate).toISOString()}>{dateLabel(post.pubDate)}</time>
								</p>
								<h3>
									<a href={getPermalink(post.slug, 'post')}>{post.title}</a>
								</h3>
								<p class="muted mt-3 text-sm">{post.description}</p>
							</article>
						))
					}
				</div>
				<aside class="surface self-start" aria-label="Other publications">
					<p class="eyebrow">Beyond this blog</p>
					{
						publications.slice(1).map((publication) => (
							<div class="mt-5">
								<h3>
									<a href={publication.url}>
										{publication.name} <span aria-hidden="true">↗</span>
									</a>
								</h3>
								<p class="muted text-sm mt-2">{publication.description}</p>
							</div>
						))
					}
					<p class="mt-6 text-sm"><a href="/rss.xml">Follow this blog via RSS <span aria-hidden="true">→</span></a></p>
				</aside>
			</div>
		</Section>
		<Section id="research" number="03" title="Research">
			<a slot="link" href="/research">Explore the research <span aria-hidden="true">→</span></a>
			<p class="muted max-w-3xl mb-7">
				My work spans AI agents, developer tooling, and software supply chain security: co-authored papers,
				vulnerability disclosures, patents, and research that became practical defenses.
			</p>
			<PaperList limit={2} />
			<div class="mt-7 flex flex-wrap gap-x-6 gap-y-3 text-sm">
				<a href="/research/papers">All papers <span aria-hidden="true">→</span></a>
				<a href="/research/advisories">CVEs & advisories <span aria-hidden="true">→</span></a>
				<a href="/research/lockfile-injection">Lockfile injection research <span aria-hidden="true">→</span></a>
			</div>
		</Section>
		<Section id="open-source" number="04" title="Open source">
			<a slot="link" href={PROFILE.githubURL}>All projects on GitHub <span aria-hidden="true">↗</span></a>
			<div class="surface mb-8">
				<dl class="impact-metrics grid sm:grid-cols-3 gap-6 mb-6">
					<div>
						<dt class="muted text-sm">npm downloads</dt><dd class="text-4xl font-bold tracking-tight mt-1">
							{downloadLabel}
						</dd><p class="text-xs muted mt-1">{downloads.packages.length} selected maintained packages</p>
					</div>
					<div>
						<dt class="muted text-sm">GitHub stars</dt><dd class="text-4xl font-bold tracking-tight mt-1">
							{totalStars.toLocaleString('en-US')}
						</dd><p class="text-xs muted mt-1">{github.repositories.length} featured repositories</p>
					</div>
					<div>
						<dt class="muted text-sm">GitHub forks</dt><dd class="text-4xl font-bold tracking-tight mt-1">
							{totalForks.toLocaleString('en-US')}
						</dd><p class="text-xs muted mt-1">{github.repositories.length} featured repositories</p>
					</div>
				</dl>
				<div class="text-sm muted">
					<p>
						{dateLabel(downloads.start)} – {dateLabel(downloads.end)}. Package downloads, not unique developers; totals
						include dependency installs.
					</p>
					<details class="mt-3 group">
						<summary
							class="flex items-center justify-between gap-4 list-none [&::-webkit-details-marker]:hidden cursor-pointer text-primary-700 dark:text-primary-300 underline underline-offset-4"
						>
							<span>Packages & source counts</span>
							<span aria-hidden="true" class="group-open:hidden">+</span>
							<span aria-hidden="true" class="hidden group-open:inline">−</span>
						</summary>
						<ul class="mt-3 space-y-2">
							{
								downloads.packages.map((pkg) => (
									<li class="flex flex-wrap justify-between gap-x-4">
										<>
											<a href={`https://api.npmjs.org/downloads/point/${downloads.start}:${downloads.end}/${pkg.name}`}>
												{pkg.name}
											</a>
											<span>{pkg.downloads.toLocaleString('en-US')}</span>
										</>
									</li>
								))
							}
						</ul>
					</details>
					<p class="mt-3">
						GitHub snapshot: {dateLabel(github.asOf)}. Stars and forks across the six featured repositories, not unique
						people or all my projects.
					</p>
					<details class="mt-3 group">
						<summary
							class="flex items-center justify-between gap-4 list-none [&::-webkit-details-marker]:hidden cursor-pointer text-primary-700 dark:text-primary-300 underline underline-offset-4"
						>
							<span>Repositories & source counts</span><span aria-hidden="true" class="group-open:hidden">+</span><span
								aria-hidden="true"
								class="hidden group-open:inline">−</span
							>
						</summary>
						<ul class="mt-3 space-y-2">
							{
								github.repositories.map((repo) => (
									<li class="flex flex-wrap justify-between gap-x-4">
										<>
											<a href={repo.url}>{repo.name}</a>
											<span>
												{repo.stars.toLocaleString('en-US')} stars · {repo.forks.toLocaleString('en-US')} forks
											</span>
										</>
									</li>
								))
							}
						</ul>
					</details>
					<p class="mt-3">
						<a href="https://www.npmjs.com/~lirantal" class="flex items-center justify-between gap-4">
							<span>Browse all my npm packages</span><span aria-hidden="true">↗</span>
						</a>
					</p>
				</div>
			</div>
			<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-8">
				{
					projects.map((project) => (
						<article>
							<p class="eyebrow">{project.kind}</p>
							<h3>
								<a href={project.url}>
									{project.name} <span aria-hidden="true">↗</span>
								</a>
							</h3>
							<ProjectBadges url={project.url} npm={project.npm} name={project.name} />
							<p class="mt-3 muted text-sm">{project.description}</p>
						</article>
					))
				}
			</div>
		</Section>
		<Section id="books" number="05" title="Books">
			<a slot="link" href="/books/nodejs-secure-coding"
				>Explore Node.js Secure Coding <span aria-hidden="true">→</span></a
			>
			<p class="muted max-w-2xl mb-8">
				Practical guides built around real vulnerabilities, with code to break, fixes to understand, and techniques to
				take back to your own projects.
			</p>
			<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-9">
				{
					books.map((book) => (
						<article>
							<a href={book.url} class="book-cover block mb-5" tabindex="-1" aria-hidden="true">
								<Image
									src={book.image}
									alt=""
									widths={[180, 360]}
									sizes="(max-width: 639px) 40vw, 190px"
									class="h-52 w-full object-contain object-left-bottom"
								/>
							</a>
							<p class="text-xs muted mb-2">{book.series}</p>
							<h3 class="!text-base">
								<a href={book.url}>
									{book.title} <span aria-hidden="true">↗</span>
								</a>
							</h3>
						</article>
					))
				}
			</div>
		</Section>
		<section class="portfolio-section grid md:grid-cols-[1fr_2fr] gap-6" aria-labelledby="community-title">
			<div><p class="eyebrow">From the community</p><h2 id="community-title">Better together.</h2></div>
			<div>
				<div class="community-quotes">
					{
						community.map((person) => (
							<div class="community-quote flex gap-4">
								<img
									src={person.avatar}
									alt=""
									width="44"
									height="44"
									loading="lazy"
									decoding="async"
									class="w-11 h-11 rounded-full object-cover shrink-0"
								/>
								<figure>
									<blockquote class="inline">“{person.quote}”</blockquote>{' '}
									<figcaption class="inline text-sm muted">
										— by <span class="font-medium">{person.name}</span>, {person.role} ·{' '}
										<a href={person.url} aria-label={`Original post by ${person.name}`}>
											Original post <span aria-hidden="true">↗</span>
										</a>
									</figcaption>
								</figure>
							</div>
						))
					}
				</div>
				<p class="text-sm mt-6">
					<a href="/recognitions">More community feedback & recognitions <span aria-hidden="true">→</span></a>
				</p>
			</div>
		</section>
	</div>
</Layout>

<script>
	import '~/scripts/register-blog-search.js';
</script>
