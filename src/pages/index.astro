---
import { Image } from 'astro:assets';
import { SITE, PROFILE } from '~/config.mjs';
import { getCanonical, getHomePermalink } from '~/utils/permalinks';
import Layout from '~/layouts/PageLayout.astro';
import ProfileHero from '~/components/widgets/ProfileHero.astro';
import Recognition from '~/components/forma/Recognition.astro';
import Projects from '~/components/forma/Projects.astro';
import Impact from '~/components/forma/Impact.astro';
import Books from '~/components/forma/Books.astro';
import Community from '~/components/forma/Community.astro';
import PostCards from '~/components/forma/PostCards.astro';
import BlogSearchRegistration from '~/components/blog/BlogSearchRegistration.astro';
import PaperList from '~/components/research/PaperList.astro';
import MediaList from '~/components/forma/MediaList.astro';
import { featuredMedia } from '~/data/media';
import { publications } from '~/data/portfolio';
import { getSpeaking } from '~/utils/speaking';
import stage from '~/assets/images/speaking-hero.jpg';
const { stats } = await getSpeaking();
const meta = {
	title: 'Liran Tal — AI Security Research & Node.js Security',
	description: SITE.description,
	canonical: getCanonical(getHomePermalink()),
};
---

<Layout {meta}>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: SITE.name,
			url: SITE.origin,
			description: SITE.description,
			jobTitle: 'Software engineer, security researcher, and open-source maintainer',
			sameAs: [PROFILE.githubURL, PROFILE.linkedinURL, PROFILE.twitterURL, PROFILE.mastodonURL],
		})}
	/>
	<ProfileHero /><Recognition />
	<section class="forma-section home-research" id="research" aria-labelledby="research-title">
		<div class="forma-wrap">
			<header class="forma-section-heading">
				<h2 id="research-title">Research</h2><a class="forma-button forma-button-secondary" href="/research"
					>Explore research</a
				>
			</header>
			<p class="forma-section-intro">
				My work spans AI agents, developer tooling, and software supply chain security: co-authored papers,
				vulnerability disclosures, patents, and research that became practical defenses.
			</p>
			<PaperList limit={2} /><div class="forma-section-actions">
				<a href="/research/papers">All papers</a><a href="/research/reports">Reports & chapters</a><a
					href="/research/advisories">CVEs & advisories</a
				><a href="/research/lockfile-injection">Lockfile injection research</a>
			</div>
		</div>
	</section>
	<section class="forma-section home-tools" id="tools" aria-labelledby="tools-title">
		<div class="forma-wrap">
			<header class="forma-section-heading">
				<h2 id="tools-title">Tools & resources I maintain</h2><a
					class="forma-button forma-button-secondary"
					href="#open-source">More projects & impact</a
				>
			</header><Projects featured />
		</div>
	</section>
	<section class="forma-section" id="writing" aria-labelledby="blog-title">
		<div class="forma-wrap">
			<header class="forma-section-heading">
				<div><h2 id="blog-title">Blog</h2><p>Articles on security, developer tooling, and what I’m building.</p></div><a
					class="forma-button"
					href="/writing">Read the blog</a
				>
			</header>
			<PostCards />
			<aside class="beyond-blog" aria-labelledby="beyond-title">
				<h3 id="beyond-title">Liran’s writing on the web</h3><div>
					{
						publications.slice(1).map((publication) => (
							<article>
								<>
									<h4>
										<a href={publication.url}>{publication.name}</a>
									</h4>
									<p>{publication.description}</p>
								</>
							</article>
						))
					}
				</div>
			</aside>
		</div>
	</section>
	<section class="forma-section home-speaking" id="speaking" aria-labelledby="speaking-title">
		<div class="forma-wrap">
			<header class="forma-section-heading">
				<h2 id="speaking-title">Speaking</h2><a class="forma-button" href="/speaking">Explore talks & events</a>
			</header>
			<div class="forma-speaking-content">
				<Image
					src={stage}
					alt="Liran Tal presenting at JSNation US 2025"
					widths={[480, 960]}
					sizes="(max-width:760px) 100vw, 600px"
				/><div>
					<h3>{stats.talksDelivered} talks.<br />{stats.countries} countries.</h3><p>
						Plenty of live hacking. I bring real-world attacks and practical defenses to conferences, meetups, and
						workshops. AI security, Node.js, and the software supply chain, explained through code.
					</p><div class="forma-section-actions">
						<a href="/speaking/recordings">Watch a talk</a><a href="/speaking/press-kit">Speaker press kit</a><a
							href="/speaking">Invite me to speak</a
						>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="forma-section home-impact" id="open-source" aria-labelledby="source-title">
		<div class="forma-wrap">
			<header class="forma-section-heading">
				<h2 id="source-title">Open source</h2><a class="forma-button forma-button-secondary" href={PROFILE.githubURL}
					>All projects on GitHub</a
				>
			</header>
			<Impact /><Projects />
		</div>
	</section>
	<section class="forma-section" id="books" aria-labelledby="books-title">
		<div class="forma-wrap">
			<header class="forma-section-heading">
				<h2 id="books-title">Books</h2><a class="forma-button forma-button-secondary" href="/books/nodejs-secure-coding"
					>Node.js Secure Coding</a
				>
			</header>
			<p class="forma-section-intro">
				Practical guides built around real vulnerabilities, with code to break, fixes to understand, and techniques to
				take back to your own projects.
			</p><Books />
		</div>
	</section>
	<section class="forma-section" id="media" aria-labelledby="media-title">
		<div class="forma-wrap">
			<header class="forma-section-heading">
				<h2 id="media-title">Selected media & interviews</h2><a
					class="forma-button forma-button-secondary"
					href="/media">View all media</a>
			</header>
			<MediaList entries={featuredMedia} compact />
		</div>
	</section>
	<section class="forma-section home-community"><div class="forma-wrap"><Community /></div></section>
</Layout>
<BlogSearchRegistration />
