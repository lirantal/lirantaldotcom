---
import Layout from '~/layouts/PageLayout.astro';
import { getCanonical, getPermalink } from '~/utils/permalinks';

const meta = {
	title: 'ChatGPT Security Models UI',
	description: 'ChatGPT with AI Security is so easy, just choose the right model version for your needs.',
	canonical: getCanonical(getPermalink(Astro.url.pathname)),
};
---

<Layout {meta}>
	<section>
		<div class="px-5 py-4 mx-auto">
			<div class="mx-auto max-w-screen-2xl text-center mb-8">
				<h1 class="text-2xl tracking-tight mb-4">ChatGPT Security Models</h1>
				<p>
					Sprinkle a bit of security magic on top of your ChatGPT models, do ya?
					<span class="block">
						Ahh yes, AI models are so easy to get right, just choose the right model version to fix your security
						issues.
					</span>
				</p>
				<div class="flex flex-col items-center mr-4 mt-8">
					<iframe
						src="https://v0-chat-gpt-clone-website-nu.vercel.app"
						allow="cross-origin-isolated"
						class="w-full h-screen"
						title="ChatGPT Security Models UI"
					>
					</iframe>
				</div>
			</div>
		</div>
	</section>
</Layout>
