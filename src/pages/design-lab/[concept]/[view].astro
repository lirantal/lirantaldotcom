---
import PreviewLayout from '~/components/design-lab/PreviewLayout.astro';
import Forma from '~/components/design-lab/v4/Forma.astro';
import FormaRefined from '~/components/design-lab/v4/FormaRefined.astro';
import Reading from '~/components/design-lab/v4/Reading.astro';
import { concepts, views } from '~/components/design-lab/concepts';
import type { Concept, View } from '~/components/design-lab/concepts';
export function getStaticPaths() {
	return concepts.flatMap((concept) =>
		views.map((view) => ({ params: { concept: concept.id, view }, props: { concept, view } }))
	);
}
interface Props {
	concept: Concept;
	view: View;
}
const { concept, view } = Astro.props;
---

<PreviewLayout {concept} {view} title={view === 'home' ? concept.name : view === 'writing' ? 'Blog' : 'Article'}>
	{
		view !== 'home' ? (
			<Reading {concept} {view} />
		) : concept.id === 'forma' ? (
			<Forma {concept} />
		) : (
			<FormaRefined {concept} />
		)
	}
</PreviewLayout>
