---
import '~/components/design-lab/round-two.css';
import PreviewLayout from '~/components/design-lab/PreviewLayout.astro';
import ConceptCard from '~/components/design-lab/ConceptCard.astro';
import { concepts } from '~/components/design-lab/concepts';
---

<PreviewLayout title="Round two — choose a direction">
	<main id="preview-main" class="gallery" tabindex="-1">
		<header class="gallery-intro">
			<p class="gallery-round">Round two</p><h1>More character.<br />A lighter perspective.</h1><p>
				Three new directions built around Manrope, compact sections, and richer compositions. Explore the homepage,
				blog, and a complete article in each before choosing what to take forward.
			</p><a href="/">Compare with the current website</a>
		</header>
		<div class="gallery-grid">{concepts.filter((c) => c.round === 2).map((concept) => <ConceptCard {concept} />)}</div>
		<section class="gallery-guide" aria-label="How to compare">
			<div>
				<h2>Same font. Different personalities.</h2><p>
					Prism layers the work, Atlas connects it, and Lumen leads with the person behind it. Each uses a different
					arrangement of the same real writing, projects, and photography.
				</p>
			</div><div>
				<h2>Start with light.</h2><p>
					All three focus on light mode, with closer section spacing and fewer visual separators. A dark variation comes
					after selecting a direction.
				</p>
			</div>
		</section>
		<details class="previous-round">
			<summary>Previous round: Fieldnotes, Signal, and After Hours</summary><p>
				Earlier proposals, kept here for comparison. The new round above responds to your feedback.
			</p><div class="gallery-grid">
				{concepts.filter((c) => c.round === 1).map((concept) => <ConceptCard {concept} />)}
			</div>
		</details>
	</main>
</PreviewLayout>
