---
import '~/components/design-lab/v4/themes.css';
import '~/components/design-lab/v4/refined.css';
import PreviewLayout from '~/components/design-lab/PreviewLayout.astro';
import ConceptCard from '~/components/design-lab/ConceptCard.astro';
import { concepts } from '~/components/design-lab/concepts';
---

<PreviewLayout title="Forma and Forma Refined">
	<main id="preview-main" class="gallery" tabindex="-1">
		<header class="gallery-intro">
			<p class="gallery-round">Round five</p><h1>Forma.<br />And one refinement.</h1><p>
				The original Forma stays as the baseline. Forma Refined combines its typography, menu, research and reading
				layouts with the hero composition and compact details from your annotations.
			</p><a href="/">Compare with the current website</a>
		</header>
		<div class="gallery-grid current-comparison">{concepts.map((concept) => <ConceptCard {concept} />)}</div>
		<section class="gallery-guide" aria-label="What to compare">
			<div>
				<h2>The new proposal.</h2><p>
					Look for the asymmetric hero, transparent portrait, monochrome social icons, compact recognition, and category
					pills with source icons in Open source.
				</p>
			</div>
			<div>
				<h2>The familiar reading experience.</h2><p>
					Both use Forma’s side-by-side Research layout, Blog cards, article typography, button styles, and contrasting
					RSS footer.
				</p>
			</div>
		</section>
	</main>
</PreviewLayout>
