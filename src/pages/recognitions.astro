---
import Layout from '~/layouts/PageLayout.astro';
import Changelog from '~/components/widgets/Changelog.astro';
import RecognitionAwards from '~/components/widgets/RecognitionAwards.astro';
import RecognitionMilestones from '~/components/widgets/RecognitionMilestones.astro';
import '~/assets/styles/portfolio.css';
import { getCanonical } from '~/utils/permalinks';

const meta = {
	title: 'Liran Tal recognitions and achievements from the community',
	description: 'Awards, community appreciation, and personal and professional milestones for Liran Tal.',
	canonical: getCanonical('/recognitions'),
};
---

<Layout {meta}>
	<div class="portfolio recognitions">
		<header class="page-intro">
			<h1 class="mb-5">
				<span class="text-transparent bg-clip-text bg-gradient-to-r to-purple-600 from-red-500">Recognitions</span>
			</h1>
			<p class="muted max-w-prose text-lg">Awards, kind words from the community, and milestones along the way.</p>
			<p class="mt-4 text-sm">
				Explore <a href="/media">media coverage & interviews</a> and <a href="/research/reports"
					>research reports & chapters</a
				>.
			</p>
			<nav aria-label="On this page" class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm">
				<a href="#awards-heading">Awards ↓</a>
				<a href="#milestones-heading">Milestones ↓</a>
				<a href="#community-heading">Appreciation ↓</a>
			</nav>
		</header>
		<RecognitionAwards />
		<RecognitionMilestones />
		<Changelog />
	</div>
</Layout>

<style>
	.recognitions {
		padding-bottom: 4rem;
	}
	.recognitions :global(h2[id]) {
		scroll-margin-top: 6rem;
	}
</style>
