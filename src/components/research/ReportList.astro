---
import { researchReports } from '~/data/research-reports';
import { dateLabel } from '~/data/research';

interface Props {
	headingLevel?: 'h2' | 'h3';
}
const { headingLevel: Heading = 'h3' } = Astro.props;
---

<div class="report-list">
	{
		researchReports.map((report) => (
			<article class="editorial-row">
				<p class="muted text-sm mb-3">
					{report.publisher} · <time datetime={report.date}>{dateLabel(report.date)}</time> · {report.role}
				</p>
				<Heading class="report-title">
					<a href={report.url}>{report.title}</a>
				</Heading>
				<p class="muted mt-3 max-w-[65ch]">{report.description}</p>
				<p class="muted text-sm mt-3">{report.credits}</p>
			</article>
		))
	}
</div>

<style>
	.report-list .report-title {
		font-size: 22px;
		line-height: 1.4;
		letter-spacing: -0.025em;
	}
</style>
