---
import { papers } from '~/data/research';
const { limit = papers.length } = Astro.props;
---

<div class="forma-paper-list">
	{
		papers.slice(0, limit).map((paper) => (
			<article>
				<p class="forma-meta">{paper.date} · arXiv preprint</p>
				<h3>
					<a href={`https://arxiv.org/abs/${paper.id}`}>{paper.title}</a>
				</h3>
				<p>{paper.description}</p>
				<p class="forma-authors">{paper.authors}</p>
				<div class="forma-small-actions">
					<a href={`https://arxiv.org/pdf/${paper.id}`}>Read PDF</a>
					<a href={`https://doi.org/10.48550/arXiv.${paper.id}`}>DOI</a>
				</div>
			</article>
		))
	}
</div>
