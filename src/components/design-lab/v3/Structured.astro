---
import Shell from './Shell.astro';
import Awards from './Awards.astro';
import Impact from './Impact.astro';
import Content from './Content.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { PROFILE } from '~/config.mjs';
import type { Concept } from '../concepts';
import portrait from '~/assets/images/liran-tal-portrait.jpg';
interface Props {
	concept: Concept;
}
const { concept } = Astro.props;
const sections = [
	{ id: 'speaking', title: 'Speaking', number: '01', href: '/speaking', action: 'Talks & events' },
	{ id: 'blog', title: 'Blog', number: '02', href: '/design-lab/structured/writing', action: 'All articles' },
	{ id: 'research', title: 'Research', number: '03', href: '/research', action: 'Research & disclosures' },
	{ id: 'open-source', title: 'Open source', number: '04', href: PROFILE.githubURL, action: 'All projects' },
	{ id: 'books', title: 'Books', number: '05', href: '/books/nodejs-secure-coding', action: 'Node.js Secure Coding' },
] as const;
---

<Shell {concept}>
	<main id="preview-main" tabindex="-1">
		<section class="structured-hero" aria-labelledby="structured-title">
			<div>
				<p class="v3-role">Security researcher · Author · Open-source maintainer</p><h1 id="structured-title">
					Securing the <span>agentic future.</span>
				</h1><p class="v3-lede">
					I research emerging threats and build open-source defenses for AI agents, the software they write, and the
					tools they trust.
				</p><p>I head Developer Relations at <a href="https://snyk.io/contributors/liran-tal/">Snyk</a>.</p><div
					class="v3-section-actions"
				>
					<a href="/design-lab/structured/writing">Read my blog</a><a href="/speaking">Invite me to speak</a><a
						href="/speaking/press-kit">Bio & press kit</a
					>
				</div>
			</div><div class="structured-profile">
				<Image src={portrait} alt="Liran Tal" width={208} height={208} loading="eager" fetchpriority="high" /><nav
					aria-label="Social profiles"
				>
					<a href={PROFILE.twitterURL} aria-label="X / Twitter"><Icon name="tabler:brand-x" aria-hidden="true" /></a><a
						href={PROFILE.githubURL}
						aria-label="GitHub"><Icon name="tabler:brand-github" aria-hidden="true" /></a
					><a href={PROFILE.linkedinURL} aria-label="LinkedIn"
						><Icon name="tabler:brand-linkedin" aria-hidden="true" /></a
					>
				</nav>
			</div>
		</section>
		<Awards />
		<section class="structured-featured" aria-labelledby="featured-title">
			<h2 id="featured-title">Tools & resources I maintain</h2><Content
				kind="open-source"
				concept="structured"
				featured
			/>
		</section>
		{
			sections.map((section) => (
				<section
					id={section.id}
					class:list={['structured-section', `structured-${section.id}`]}
					aria-labelledby={`structured-${section.id}-title`}
				>
					<>
						<header>
							<>
								<span class="structured-number">{section.number}</span>
								<h2 id={`structured-${section.id}-title`}>{section.title}</h2>
								<a href={section.href}>{section.action}</a>
							</>
						</header>
						<div class="structured-section-body">
							{section.id === 'open-source' && <Impact />}
							<Content
								kind={section.id}
								concept="structured"
								limit={
									section.id === 'books' ? 5 : section.id === 'research' ? 2 : section.id === 'open-source' ? 6 : 3
								}
							/>
						</div>
					</>
				</section>
			))
		}
		<section class="structured-community" aria-labelledby="structured-community-title">
			<h2 id="structured-community-title">Community</h2><Content kind="community" concept="structured" />
		</section>
	</main>
</Shell>
