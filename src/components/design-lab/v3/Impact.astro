---
import downloads from '~/data/npm-downloads.json';
import github from '~/data/github-impact.json';
const total = downloads.packages.reduce((sum, pkg) => sum + pkg.downloads, 0);
const stars = github.repositories.reduce((sum, repo) => sum + repo.stars, 0);
const forks = github.repositories.reduce((sum, repo) => sum + repo.forks, 0);
---

<div class="structured-impact">
	<dl>
		<div><dt>npm downloads</dt><dd>{(total / 1_000_000).toFixed(2)}M</dd></div><div>
			<dt>GitHub stars</dt><dd>{stars.toLocaleString('en-US')}</dd>
		</div><div><dt>GitHub forks</dt><dd>{forks.toLocaleString('en-US')}</dd></div>
	</dl><p>
		{downloads.start} to {downloads.end}: {downloads.packages.length} selected maintained packages. Downloads include dependency
		installs, not unique developers. GitHub snapshot: {github.asOf}; {github.repositories.length} featured repositories, not
		unique people.
	</p><details>
		<summary>Packages, repositories & source counts</summary><ul>
			{
				downloads.packages.map((pkg) => (
					<li>
						<a href={`https://api.npmjs.org/downloads/point/${downloads.start}:${downloads.end}/${pkg.name}`}>
							{pkg.name}
						</a>
						: {pkg.downloads.toLocaleString('en-US')} downloads
					</li>
				))
			}
		</ul><ul>
			{
				github.repositories.map((repo) => (
					<li>
						<a href={repo.url}>{repo.name}</a>: {repo.stars.toLocaleString('en-US')} stars,{' '}
						{repo.forks.toLocaleString('en-US')} forks
					</li>
				))
			}
		</ul>
	</details>
</div>
