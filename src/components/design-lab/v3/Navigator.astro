---
import type { Concept, View } from '../concepts';
import { previewURL } from '../concepts';
import Awards from './Awards.astro';
import Content from './Content.astro';
import Article from './Article.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { PROFILE } from '~/config.mjs';
import portrait from '~/assets/images/liran-tal-portrait.jpg';
import './themes.css';
interface Props {
	concept: Concept;
	view: View;
}
const { concept, view } = Astro.props;
const items = [
	{ id: 'research', title: 'Research', icon: 'tabler:file-search' },
	{ id: 'open-source', title: 'Open source', icon: 'tabler:code' },
	{ id: 'speaking', title: 'Speaking', icon: 'tabler:microphone' },
	{ id: 'books', title: 'Books', icon: 'tabler:book' },
	{ id: 'blog', title: 'Blog', icon: 'tabler:article' },
] as const;
---

<div class="v3 v3-navigator">
	<div class="navigator-shell" data-navigator data-initial={view === 'home' ? 'research' : 'blog'}>
		<aside class="navigator-rail">
			<a class="navigator-brand" href={previewURL(concept.id)}>Liran Tal</a><div class="navigator-person">
				<Image src={portrait} alt="Liran Tal" width={96} height={96} loading="eager" /><p>
					Security researcher.<br />Author. Maintainer.
				</p>
			</div><nav class="navigator-tabs" aria-label="Portfolio sections">
				{
					items.map((item) => (
						<a
							aria-current={view === 'article' && item.id === 'blog' ? 'page' : undefined}
							data-work-tab={item.id}
							href={view === 'article' ? `${previewURL(concept.id)}#navigator-${item.id}` : `#navigator-${item.id}`}
						>
							<>
								<Icon name={item.icon} aria-hidden="true" />
								<span>{item.title}</span>
							</>
						</a>
					))
				}
			</nav><div class="navigator-rail-links">
				<a href="/speaking/press-kit">Bio & press kit</a><a href={PROFILE.githubURL}>GitHub</a><a
					href={PROFILE.twitterURL}>X / Twitter</a
				><a href={PROFILE.linkedinURL}>LinkedIn</a><a href="/">Current website</a>
			</div>
		</aside>
		<main id="preview-main" class="navigator-main" tabindex="-1">
			{
				view === 'article' ? (
					<Article concept={concept.id} />
				) : (
					<>
						{view === 'home' && (
							<header class="navigator-intro">
								<div>
									<p>AI security · Node.js · Software supply chain</p>
									<h1>Securing the agentic future.</h1>
									<p>
										I research emerging threats and build open-source defenses for AI agents, the software they write,
										and the tools they trust.
									</p>
								</div>
								<a href="https://snyk.io/contributors/liran-tal/">Developer Relations at Snyk</a>
							</header>
						)}
						{view === 'home' && <Awards />}
						{view === 'writing' && (
							<h1 class="navigator-page-title" data-work-heading>
								Blog
							</h1>
						)}
						<div class="navigator-workspace">
							{items.map((item) => (
								<section
									id={`navigator-${item.id}`}
									data-work-panel={item.id}
									aria-labelledby={`navigator-${item.id}-title`}
								>
									<header class="navigator-panel-heading">
										<h2 id={`navigator-${item.id}-title`}>{item.title}</h2>
										<a
											href={
												item.id === 'research'
													? '/research'
													: item.id === 'open-source'
														? PROFILE.githubURL
														: item.id === 'speaking'
															? '/speaking'
															: item.id === 'books'
																? '/books/nodejs-secure-coding'
																: '/blog'
											}
										>
											{item.id === 'research'
												? 'Research & disclosures'
												: item.id === 'blog'
													? 'Search the full archive'
													: item.id === 'books'
														? 'Node.js Secure Coding'
														: item.id === 'speaking'
															? 'Talks & events'
															: 'GitHub'}
										</a>
									</header>
									<Content
										kind={item.id}
										concept="navigator"
										limit={item.id === 'blog' ? 6 : item.id === 'books' ? 5 : 3}
									/>
								</section>
							))}
						</div>
					</>
				)
			}
		</main>
	</div>
</div>
<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-navigator]')) {
		const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-work-tab]'));
		const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-work-panel]'));
		if (!panels.length) continue;
		const nav = root.querySelector('.navigator-tabs');
		nav?.setAttribute('role', 'tablist');
		const media = matchMedia('(max-width:760px)');
		const syncOrientation = () => nav?.setAttribute('aria-orientation', media.matches ? 'horizontal' : 'vertical');
		syncOrientation();
		media.addEventListener('change', syncOrientation);
		for (const tab of tabs) {
			tab.setAttribute('role', 'tab');
			tab.id = `work-tab-${tab.dataset.workTab}`;
			tab.setAttribute('aria-controls', `navigator-${tab.dataset.workTab}`);
		}
		for (const panel of panels) {
			panel.setAttribute('role', 'tabpanel');
			panel.setAttribute('aria-labelledby', `work-tab-${panel.dataset.workPanel}`);
			panel.tabIndex = 0;
		}
		function select(id: string, updateHash = false) {
			if (!panels.some((p) => p.dataset.workPanel === id)) return;
			for (const p of panels) p.hidden = p.dataset.workPanel !== id;
			for (const t of tabs) {
				const active = t.dataset.workTab === id;
				t.setAttribute('aria-selected', String(active));
				t.tabIndex = active ? 0 : -1;
			}
			const heading = root.querySelector('[data-work-heading]');
			if (heading) heading.textContent = tabs.find((t) => t.dataset.workTab === id)?.textContent?.trim() || id;
			if (updateHash) history.replaceState(null, '', `#navigator-${id}`);
		}
		function fromHash() {
			const id = location.hash.replace('#navigator-', '');
			select(panels.some((p) => p.dataset.workPanel === id) ? id : root.dataset.initial || 'research');
		}
		for (const [index, tab] of tabs.entries()) {
			tab.addEventListener('click', (event) => {
				event.preventDefault();
				select(tab.dataset.workTab || 'research', true);
			});
			tab.addEventListener('keydown', (event) => {
				const key = event.key;
				if (key === ' ' || key === 'Enter') {
					event.preventDefault();
					select(tab.dataset.workTab || 'research', true);
					return;
				}
				if (!['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(key)) return;
				event.preventDefault();
				const next =
					key === 'Home'
						? 0
						: key === 'End'
							? tabs.length - 1
							: (index + (['ArrowDown', 'ArrowRight'].includes(key) ? 1 : -1) + tabs.length) % tabs.length;
				tabs[next].focus();
				select(tabs[next].dataset.workTab || 'research', true);
			});
		}
		fromHash();
		window.addEventListener('hashchange', fromHash);
	}
</script>
