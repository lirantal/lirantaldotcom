---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { papers } from '~/data/research';
import { projects, books } from '~/data/portfolio';
import { community } from '~/data/community';
import { getSpeaking } from '~/utils/speaking';
import { fetchPosts } from '~/utils/posts';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { previewURL } from '../concepts';
import { PROFILE } from '~/config.mjs';
import Picture from '~/components/core/Picture.astro';
import stage from '~/assets/images/speaking-hero.jpg';
interface Props {
	kind: 'research' | 'open-source' | 'speaking' | 'books' | 'blog' | 'community';
	concept: string;
	limit?: number;
	featured?: boolean;
}
const { kind, concept, limit = 3, featured: useFeatured = false } = Astro.props;
const posts = kind === 'blog' ? (await fetchPosts()).slice(0, limit) : [];
const covers = await Promise.all(posts.map((post) => findImage(post.image)));
const speaking = kind === 'speaking' ? await getSpeaking() : null;
const date = (value: string) =>
	new Date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const featured = useFeatured
	? projects.filter((p) => ['lockfile-lint', 'npq', 'Node.js CLI Apps Best Practices'].includes(p.name))
	: projects.slice(0, limit);
---

{
	kind === 'research' && (
		<div class="v3-research-content">
			<>
				<p class="v3-section-intro">
					AI agents, developer tooling, and software supply chain security. Selected co-authored preprints, with primary
					sources.
				</p>
				<div class="v3-paper-list">
					{papers.slice(0, limit).map((paper) => (
						<article>
							<p class="v3-meta">{paper.date} · arXiv preprint</p>
							<h3>
								<a href={`https://arxiv.org/abs/${paper.id}`}>{paper.title}</a>
							</h3>
							<p>{paper.description}</p>
							<p class="v3-authors">{paper.authors}</p>
							<div class="v3-small-actions">
								<a href={`https://arxiv.org/pdf/${paper.id}`}>Read PDF</a>
								<a href={`https://doi.org/10.48550/arXiv.${paper.id}`}>DOI</a>
							</div>
						</article>
					))}
				</div>
				<div class="v3-section-actions">
					<>
						<a href="/research/papers">All papers</a>
						<a href="/research/advisories">CVEs & advisories</a>
						<a href="/research/lockfile-injection">Lockfile injection research</a>
					</>
				</div>
			</>
		</div>
	)
}
{
	kind === 'open-source' && (
		<div>
			<>
				<div class="v3-projects">
					{featured.map((project, index) => (
						<article>
							<span class="v3-project-symbol">
								<Icon
									name={index === 0 ? 'tabler:shield-check' : index === 1 ? 'tabler:package' : 'tabler:terminal-2'}
									aria-hidden="true"
								/>
							</span>
							<p class="v3-meta">{project.kind}</p>
							<h3>
								<a href={project.url}>{project.name}</a>
							</h3>
							<p>{project.description}</p>
							<div class="v3-small-actions">
								<a href={project.url}>GitHub</a>
								{project.npm && <a href={`https://www.npmjs.com/package/${project.npm}`}>npm</a>}
							</div>
						</article>
					))}
				</div>
				<div class="v3-section-actions">
					<a href={PROFILE.githubURL}>All projects on GitHub</a>
				</div>
			</>
		</div>
	)
}
{
	kind === 'speaking' && (
		<div class="v3-speaking-content">
			<>
				<Image
					src={stage}
					alt="Liran Tal presenting at JSNation US 2025"
					widths={[480, 960]}
					sizes="(max-width: 760px) 100vw, 600px"
				/>
				<div>
					<>
						<h3>
							{speaking?.stats.talksDelivered} talks.
							<br />
							{speaking?.stats.countries} countries.
						</h3>
						<p>
							I bring real-world attacks and practical defenses to conferences, meetups, and workshops. AI security,
							Node.js, and the software supply chain, explained through code.
						</p>
						<div class="v3-section-actions">
							<>
								<a href="/speaking/recordings">Watch a talk</a>
								<a href="/speaking/press-kit">Speaker press kit</a>
								<a href="/speaking">Talks & events</a>
							</>
						</div>
					</>
				</div>
			</>
		</div>
	)
}
{
	kind === 'books' && (
		<div class="v3-book-list">
			{books.slice(0, limit).map((book) => (
				<article>
					<a href={book.url}>
						<Image src={book.image} alt={book.title} widths={[180, 360]} sizes="(max-width: 760px) 38vw, 180px" />
						<span>{book.series}</span>
						<h3>{book.title}</h3>
					</a>
				</article>
			))}
		</div>
	)
}
{
	kind === 'blog' && (
		<div class="v3-blog-list">
			{posts.map((post, index) => (
				<article>
					<a
						class="v3-blog-thumb"
						tabindex="-1"
						aria-hidden="true"
						href={index === 0 ? previewURL(concept, 'article') : getPermalink(post.slug, 'post')}
					>
						<Picture src={covers[index]} alt="" widths={[240, 480]} sizes="(max-width: 760px) 96px, 144px" />
					</a>
					<div>
						<p class="v3-meta">
							<time datetime={new Date(post.pubDate).toISOString()}>{date(post.pubDate)}</time>
						</p>
						<h3>
							<a href={index === 0 ? previewURL(concept, 'article') : getPermalink(post.slug, 'post')}>{post.title}</a>
						</h3>
						<p>{post.description}</p>
					</div>
				</article>
			))}
		</div>
	)
}
{
	kind === 'community' && (
		<div class="v3-community-list">
			{community.slice(0, 2).map((person) => (
				<figure>
					<img src={person.avatar} alt="" width="44" height="44" loading="lazy" />
					<div>
						<blockquote>“{person.quote}”</blockquote>
						<figcaption>
							{person.name}, {person.role} · <a href={person.url}>Original post</a>
						</figcaption>
					</div>
				</figure>
			))}
		</div>
	)
}
