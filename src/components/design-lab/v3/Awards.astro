---
import { Icon } from 'astro-icon/components';
---

<section class="v3-recognition" aria-labelledby="recognition-title">
	<div class="v3-recognition-heading">
		<h2 id="recognition-title">Recognition</h2><a href="/recognitions">All recognition</a>
	</div>
	<div class="v3-awards">
		<a class="v3-award github-award" href="https://stars.github.com/alumni"
			><Icon name="tabler:brand-github" aria-hidden="true" /><span
				><span class="v3-award-org">GitHub</span><strong>GitHub Star</strong><span class="v3-award-link"
					>View GitHub Stars alumni</span
				></span
			></a
		>
		<a class="v3-award openjs-award" href="/recognitions"
			><Icon name="tabler:award" aria-hidden="true" /><span
				><span class="v3-award-org">OpenJS Foundation</span><strong>Security Pathfinder</strong><span
					class="v3-award-link">View award & recognition</span
				></span
			></a
		>
	</div>
</section>
