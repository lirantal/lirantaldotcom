---
import { Icon } from 'astro-icon/components';
---

<section class="d5-recognition d4-wrap" aria-label="Recognition">
	<ul aria-label="Awards and recognition" role="list">
		<li>
			<a href="https://stars.github.com/alumni"
				><Icon name="tabler:brand-github" aria-hidden="true" /><span
					><span class="d5-awarded">Awarded</span> GitHub Star <span class="d5-alumni">(alumni)</span></span
				></a>
		</li>
		<li>
			<a href="/recognitions"
				><Icon name="tabler:award" aria-hidden="true" /><span
					><span class="d5-awarded">Awarded</span> OpenJS Security Pathfinder</span
				></a>
		</li>
		<li class="d5-recognition-more">
			<span class="d5-recognition-separator" aria-hidden="true">|</span><a
				class="d5-all-recognition"
				href="/recognitions">All recognitions</a>
		</li>
	</ul>
</section>
