	<ul aria-label="Awards and recognition" role="list">
		<li>
			<a href="https://stars.github.com/alumni"
				><Icon name="tabler:brand-github" aria-hidden="true" /><span
					>GitHub Star <span class="d5-alumni">(alumni)</span></span
				></a>
		</li>
		<li>
			<a href="/recognitions"><Icon name="tabler:award" aria-hidden="true" /><span>OpenJS Security Pathfinder</span></a>
		</li>
	</ul>
	<a class="d5-all-recognition" href="/recognitions">All recognition</a>
</section>
