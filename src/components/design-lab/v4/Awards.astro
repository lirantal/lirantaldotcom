---
import { Icon } from 'astro-icon/components';
---

<section class="d4-recognition d4-wrap" aria-labelledby="recognition-title">
	<div class="d4-recognition-heading">
		<h2 id="recognition-title">Recognition</h2><a href="/recognitions">All recognition</a>
	</div>
	<div class="d4-awards">
		<a href="https://stars.github.com/alumni" class="d4-award"
			><Icon name="tabler:brand-github" aria-hidden="true" /><span
				><strong>GitHub Star</strong><span>GitHub Stars alumni</span></span
			><Icon name="tabler:arrow-up-right" aria-hidden="true" /></a
		>
		<a href="/recognitions" class="d4-award"
			><Icon name="tabler:award" aria-hidden="true" /><span
				><strong>Security Pathfinder</strong><span>OpenJS Foundation</span></span
			><Icon name="tabler:arrow-up-right" aria-hidden="true" /></a
		>
	</div>
</section>
