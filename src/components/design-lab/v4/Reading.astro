---
import type { Concept, View } from '../concepts';
import Shell from './Shell.astro';
import Content from './Content.astro';
import Article from './Article.astro';
interface Props {
	concept: Concept;
	view: View;
}
const { concept, view } = Astro.props;
---

<Shell {concept}>
	<main id="preview-main" class="d4-reading-page d4-wrap" tabindex="-1">
		{
			view === 'article' ? (
				<Article concept={concept.id} />
			) : (
				<section class="d4-blog-page">
					<>
						<header class="d4-blog-heading">
							<>
								<h1>Blog</h1>
								<p class="d4-lede">
									Articles on AI agents, Node.js security, developer tooling, and the things I’m building.
								</p>
								<div class="d4-actions">
									<>
										<a class="d4-button" href="/blog">
											Search the full archive
										</a>
										<a class="d4-button d4-button-secondary" href="/rss.xml">
											Follow via RSS
										</a>
									</>
								</div>
							</>
						</header>
						<Content kind="blog" concept={concept.id} limit={6} />
						<aside class="d4-publications">
							<>
								<h2>Other publications</h2>
								<a href="https://www.nodejs-security.com/blog">Node.js Security</a>
								<a href="https://snyk.io/blog/author/liran-tal/">Snyk</a>
							</>
						</aside>
					</>
				</section>
			)
		}
	</main>
</Shell>
