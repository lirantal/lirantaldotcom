---
import Shell from './Shell.astro';
import Awards from './Awards.astro';
import Content from './Content.astro';
import { Image } from 'astro:assets';
import { PROFILE } from '~/config.mjs';
import type { Concept } from '../concepts';
import { previewURL } from '../concepts';
import portrait from '~/assets/images/liran-tal-portrait.jpg';
interface Props {
	concept: Concept;
}
const { concept } = Astro.props;
---

<Shell {concept}>
	<main id="preview-main" tabindex="-1">
		<section class="prism-intro d4-wrap" aria-labelledby="prism-title">
			<div>
				<h1 id="prism-title">Securing the<br />agentic future.</h1>
				<p class="d4-lede">
					I research emerging threats and build open-source defenses for AI agents, the software they write, and the
					tools they trust.
				</p>
				<p class="d4-role">
					Liran Tal. Security researcher, author, and open-source maintainer.<br />I head Developer Relations at <a
						href="https://snyk.io/contributors/liran-tal/">Snyk</a
					>.
				</p>
				<div class="d4-actions">
					<a class="d4-button" href="/research">Explore my research</a><a
						class="d4-button d4-button-secondary"
						href={previewURL(concept.id, 'writing')}>Explore the blog</a>
				</div>
				<nav class="d4-socials" aria-label="Social profiles">
					<a href={PROFILE.githubURL}>GitHub</a><a href={PROFILE.linkedinURL}>LinkedIn</a><a href={PROFILE.twitterURL}
						>X / Twitter</a>
				</nav>
			</div>
			<Image
				class="prism-portrait"
				src={portrait}
				alt="Liran Tal"
				widths={[340, 680]}
				sizes="(max-width: 760px) 260px, 340px"
				loading="eager"
				fetchpriority="high"
			/>
		</section>
		<Awards />
		<section class="d4-section prism-research" id="research" aria-labelledby="research-title">
			<div class="d4-wrap">
				<header class="d4-section-heading">
					<h2 id="research-title">Research</h2><a class="d4-button d4-button-secondary" href="/research"
						>Explore research</a>
				</header>
				<Content kind="research" concept="prism" limit={2} />
			</div>
		</section>
		<section class="d4-section" id="open-source" aria-labelledby="source-title">
			<div class="d4-wrap">
				<header class="d4-section-heading">
					<div><h2 id="source-title">Open source</h2><p>Tools and resources I build and maintain.</p></div><a
						class="d4-button d4-button-secondary"
						href={PROFILE.githubURL}>View GitHub</a>
				</header>
				<Content kind="open-source" concept="prism" featured />
			</div>
		</section>
		<section class="d4-section prism-speaking" id="speaking" aria-labelledby="speaking-title">
			<div class="d4-wrap">
				<header class="d4-section-heading">
					<h2 id="speaking-title">Speaking</h2><a class="d4-button" href="/speaking">Invite me to speak</a>
				</header><Content kind="speaking" concept="prism" />
			</div>
		</section>
		<section class="d4-section" id="books" aria-labelledby="books-title">
			<div class="d4-wrap">
				<header class="d4-section-heading">
					<h2 id="books-title">Books</h2><a href="/books/nodejs-secure-coding">Node.js Secure Coding</a>
				</header><Content kind="books" concept="prism" limit={5} />
			</div>
		</section>
		<section class="d4-section prism-blog" id="blog" aria-labelledby="blog-title">
			<div class="d4-wrap">
				<header class="d4-section-heading">
					<div>
						<h2 id="blog-title">Blog</h2><p>Articles on security, developer tooling, and what I’m building.</p>
					</div><a class="d4-button" href={previewURL(concept.id, 'writing')}>Explore the blog</a>
				</header><Content kind="blog" concept="prism" />
			</div>
		</section>
	</main>
</Shell>
