---
const { id, number, title, description } = Astro.props;
---

<section {id} aria-labelledby={`${id}-title`} class="portfolio-section">
	<div class="section-heading">
		<div>
			<h2 id={`${id}-title`} class="uppercase">{number} / {title}</h2>
			{description && <p class="mt-3 text-lg muted">{description}</p>}
		</div>
		<slot name="link" />
	</div>
	<slot />
</section>
