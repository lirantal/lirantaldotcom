<script is:inline>
	// Light is the default; only an explicit saved preference enables dark mode.
	if (localStorage.theme === 'dark') {
		document.documentElement.classList.add('dark');
	} else {
		document.documentElement.classList.remove('dark');
	}

	function attachEvent(selector, event, fn) {
		const matches = document.querySelectorAll(selector);
		if (matches && matches.length) {
			matches.forEach((elem) => {
				elem.addEventListener(event, () => fn(elem), false);
			});
		}
	}

	window.onload = function () {
		attachEvent('[data-aw-toggle-menu]', 'click', function (elem) {
			elem.classList.toggle('expanded');
			elem.setAttribute('aria-expanded', String(elem.classList.contains('expanded')));
			document.body.classList.toggle('overflow-hidden');
			document.getElementById('menu')?.classList.toggle('hidden');
		});

		function closeMenu() {
			const toggle = document.querySelector('[data-aw-toggle-menu]');
			toggle?.classList.remove('expanded');
			toggle?.setAttribute('aria-expanded', 'false');
			document.body.classList.remove('overflow-hidden');
			document.getElementById('menu')?.classList.add('hidden');
		}
		attachEvent('#menu a', 'click', closeMenu);
		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape' && document.querySelector('[data-aw-toggle-menu].expanded')) {
				closeMenu();
				document.querySelector('[data-aw-toggle-menu]')?.focus();
			}
		});
		window.matchMedia('(min-width: 1024px)').addEventListener('change', closeMenu);

		function syncThemeToggles() {
			const isDark = document.documentElement.classList.contains('dark');
			document
				.querySelectorAll('[data-aw-toggle-color-scheme]')
				.forEach((elem) => elem.setAttribute('aria-pressed', String(isDark)));
		}
		syncThemeToggles();
		attachEvent('[data-aw-toggle-color-scheme]', 'click', function () {
			document.documentElement.classList.toggle('dark');
			localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
			syncThemeToggles();
		});
	};
	window.onpageshow = function () {
		const elem = document.querySelector('[data-aw-toggle-menu]');
		if (elem) {
			elem.classList.remove('expanded');
			elem.setAttribute('aria-expanded', 'false');
		}
		document.body.classList.remove('overflow-hidden');
		document.getElementById('menu')?.classList.add('hidden');
	};
</script>
