---
import { Icon } from 'astro-icon/components';

const {
	label = 'Toggle Menu',
	class:
		className = 'ml-1.5 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-600 dark:focus-visible:outline-primary-300 rounded-lg text-sm p-2.5 inline-flex items-center transition',
	iconClass = 'w-6 h-6',
	iconName = 'tabler:menu',
} = Astro.props;
---

<button
	type="button"
	class:list={[className, 'group']}
	aria-label={label}
	aria-expanded="false"
	aria-controls="menu"
	data-aw-toggle-menu
>
	<span class="group-[.expanded]:hidden" aria-hidden="true"><Icon name={iconName} class={iconClass} /></span>
	<span class="hidden group-[.expanded]:block" aria-hidden="true"><Icon name="tabler:x" class={iconClass} /></span>
</button>
