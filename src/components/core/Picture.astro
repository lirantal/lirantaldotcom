---
import { Picture } from 'astro:assets';

const {
	src: source,
	alt,
	sizes,
	widths = [400, 900, 1200],
	loading = 'lazy',
	decoding = 'async',
	class: className = '',
	formats = ['avif', 'webp'],
	...rest
} = Astro.props;

const resolvedSource = await source;
const src = resolvedSource?.default ?? resolvedSource;
const fallbackFormat = ['png', 'jpg', 'jpeg', 'webp', 'avif'].includes(src?.format) ? 'webp' : undefined;
---

{
	src && typeof src === 'string' && (
		<img
			src={src}
			alt={alt}
			class={className}
			loading={loading}
			decoding={decoding}
			{...Object.fromEntries(
				Object.entries(rest).filter(
					([k]) => !['aspectRatio', 'fit', 'position', 'background'].includes(k),
				),
			)}
		/>
	)
}
{
	src && typeof src !== 'string' && (
		<Picture
			src={src}
			widths={widths}
			sizes={sizes}
			formats={formats.filter((format) => format !== fallbackFormat)}
			fallbackFormat={fallbackFormat}
			alt={alt}
			class={className}
			loading={loading}
			decoding={decoding}
			fetchpriority={rest.fetchpriority}
		/>
	)
}
