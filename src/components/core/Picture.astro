---
import { Picture } from 'astro:assets';

const {
	src,
	alt,
	sizes,
	widths = [400, 900, 1200],
	loading = 'lazy',
	decoding = 'async',
	class: className = '',
	formats = ['avif', 'webp'],
	...rest
} = Astro.props;
---

{
	src && typeof src === 'string' && (
		<img
			src={src}
			alt={alt}
			class={className}
			loading={loading}
			decoding={decoding}
			{...Object.fromEntries(
				Object.entries(rest).filter(
					([k]) => !['aspectRatio', 'fit', 'position', 'background'].includes(k),
				),
			)}
		/>
	)
}
{
	src && typeof src !== 'string' && (
		<Picture
			src={src}
			widths={widths}
			sizes={sizes}
			formats={formats}
			alt={alt}
			class={className}
			loading={loading}
			decoding={decoding}
		/>
	)
}
