---
import { AstroSeo } from '@astrolib/seo';
import { GoogleAnalytics } from '@astrolib/analytics';
import { getSocialImage } from '~/utils/social-cards';

import { SITE } from '~/config.mjs';
import Fonts from '../atoms/Fonts.astro';
import ExtraMetaTags from '../atoms/ExtraMetaTags.astro';
import VercelAnalytics from './VercelAnalytics.astro';

const defaultOg = await getSocialImage(Astro.url.pathname);

const {
	title = SITE.name,
	description = '',
	image: _image = defaultOg,

	canonical,
	noindex = false,
	nofollow = false,

	ogTitle = title,
	ogType = 'website',
} = Astro.props;

function resolveOgImageUrl(img, site) {
	if (!img) return null;
	if (typeof img === 'string') {
		return new URL(img, site);
	}
	const raw = typeof img === 'object' && img && 'src' in img ? String(img.src) : null;
	if (!raw) return null;
	if (raw.startsWith('http://') || raw.startsWith('https://')) {
		return new URL(raw);
	}
	return new URL(raw, site);
}

const image = resolveOgImageUrl(_image, Astro.site);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="google-site-verification" content="8sT1AmQokUOWyrpUMkaDWQ7wXp3-Z0zELkwaeMzOcTo" />

<AstroSeo
	title={title}
	description={description}
	canonical={canonical}
	noindex={noindex}
	nofollow={nofollow}
	openGraph={{
		url: canonical,
		title: ogTitle,
		description: description,
		type: ogType,
		images: image
			? [
					{
						url: image.toString(),
						alt: _image?.alt || ogTitle,
						...(typeof _image === 'object' && _image?.width && _image?.height
							? { width: _image.width, height: _image.height }
							: {}),
					},
				]
			: undefined,
		site_name: 'Liran Tal',
	}}
	twitter={{
		handle: '@liran_tal',
		cardType: image ? 'summary_large_image' : undefined,
	}}
/>

{image && <meta name="twitter:image" content={image.toString()} />}
{image && <meta name="twitter:image:alt" content={_image?.alt || ogTitle} />}

<Fonts />

{SITE.googleSiteVerificationId && <meta name="google-site-verification" content={SITE.googleSiteVerificationId} />}

{SITE.googleAnalyticsId && <GoogleAnalytics id={String(SITE.googleAnalyticsId)} partytown={false} />}

<VercelAnalytics />

<ExtraMetaTags />
