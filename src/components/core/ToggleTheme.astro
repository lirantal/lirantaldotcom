---
import { Icon } from 'astro-icon/components';

const {
	label = 'Dark mode',
	class:
		className = 'text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-600 dark:focus-visible:outline-primary-300 rounded-lg text-sm p-2.5 inline-flex items-center',
	iconClass = 'w-6 h-6',
} = Astro.props;
---

<button type="button" class={className} aria-label={label} aria-pressed="false" data-aw-toggle-color-scheme>
	<span class="dark:hidden" aria-hidden="true"><Icon name="tabler:moon" class={iconClass} /></span>
	<span class="hidden dark:inline" aria-hidden="true"><Icon name="tabler:sun" class={iconClass} /></span>
</button>
