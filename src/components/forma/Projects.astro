---
import { Icon } from 'astro-icon/components';
import { projects } from '~/data/portfolio';
interface Props {
	featured?: boolean;
}
const { featured = false } = Astro.props;
const selected = featured
	? projects.filter((p) => ['lockfile-lint', 'npq', 'Node.js CLI Apps Best Practices'].includes(p.name))
	: projects;
---

<div class="forma-projects refined-projects">
	{
		selected.map((project) => (
			<article>
				<header>
					<>
						<h3>
							<a href={project.url}>{project.name}</a>
						</h3>
						<span class="refined-project-kind">{project.kind}</span>
					</>
				</header>
				<p>{project.description}</p>
				<nav class="refined-project-sources" aria-label={`${project.name} sources`}>
					<a href={project.url} aria-label={`${project.name} on GitHub`} title={`${project.name} on GitHub`}>
						<Icon name="tabler:brand-github" aria-hidden="true" />
					</a>
					{project.npm && (
						<a
							href={`https://www.npmjs.com/package/${project.npm}`}
							aria-label={`${project.name} on npm`}
							title={`${project.name} on npm`}
						>
							<Icon name="tabler:brand-npm" aria-hidden="true" />
						</a>
					)}
				</nav>
			</article>
		))
	}
</div>
