---
import { Icon } from 'astro-icon/components';
import downloads from '~/data/npm-downloads.json';
import github from '~/data/github-impact.json';
import contributions from '~/data/github-contributions.json';
const totalDownloads = downloads.packages.reduce((sum, p) => sum + p.downloads, 0);
const downloadLabel = `${(totalDownloads / 1_000_000).toFixed(2)}M`;
const totalStars = github.repositories.reduce((sum, r) => sum + r.stars, 0);
const dateLabel = (value: string) =>
	new Date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<div class="surface mb-8">
	<dl class="impact-metrics grid sm:grid-cols-3 gap-6 mb-6">
		<div>
			<dt class="muted text-sm">npm downloads</dt><dd class="text-4xl font-bold tracking-tight mt-1">
				{downloadLabel}
			</dd><dd class="text-xs muted mt-1">{downloads.packages.length} selected maintained packages</dd>
		</div>
		<div>
			<dt class="muted text-sm">GitHub stars</dt><dd class="text-4xl font-bold tracking-tight mt-1">
				{totalStars.toLocaleString('en-US')}
			</dd><dd class="text-xs muted mt-1">{github.repositories.length} featured repositories</dd>
		</div>
		<div>
			<dt class="muted text-sm">GitHub contributions</dt><dd class="text-4xl font-bold tracking-tight mt-1">
				<a href={contributions.source}>{contributions.total.toLocaleString('en-US')}</a>
			</dd><dd class="text-xs muted mt-1">{contributions.year} · as of {dateLabel(contributions.asOf)}</dd>
		</div>
	</dl>
	<div class="impact-sources text-sm muted">
		<section aria-labelledby="npm-source-title">
			<h3 id="npm-source-title">
				npm downloads <span class="impact-period">monthly, {downloads.end.slice(0, 4)}</span>
			</h3>
			<ul class="mt-3 space-y-2">
				{
					downloads.packages.map((pkg) => (
						<li class="flex flex-wrap justify-between gap-x-4">
							<>
								<a href={`https://www.npmjs.com/package/${pkg.name}`}>{pkg.name}</a>
								<span>{pkg.downloads.toLocaleString('en-US')}</span>
							</>
						</li>
					))
				}
			</ul>
			<p class="mt-3 impact-disclosure">
				{dateLabel(downloads.start)}–{dateLabel(downloads.end)}. Downloads, not unique developers; includes dependency
				installs. Five selected maintained packages.
			</p>
			<details class="impact-disclosure mt-3">
				<summary class="cursor-pointer">Download data sources</summary>
				<ul class="mt-2 space-y-2">
					{
						downloads.packages.map((pkg) => (
							<li>
								<a href={`https://api.npmjs.org/downloads/point/${downloads.start}:${downloads.end}/${pkg.name}`}>
									{pkg.name} download record
								</a>
							</li>
						))
					}
				</ul>
			</details>
			<p class="mt-3">
				<a href="https://www.npmjs.com/~lirantal" class="impact-browse-link">
					<span>Browse all my npm packages</span><Icon
						name="tabler:arrow-up-right"
						class="inline-block w-4 h-4 align-middle"
						aria-hidden="true"
					/>
				</a>
			</p>
		</section>
		<section aria-labelledby="github-source-title">
			<h3 id="github-source-title">
				GitHub stars &amp; forks <span class="impact-period">snapshot, {github.asOf.slice(0, 4)}</span>
			</h3>
			<ul class="mt-3 space-y-2">
				{
					github.repositories.map((repo) => (
						<li class="flex flex-wrap justify-between gap-x-4">
							<>
								<a href={repo.url}>{repo.name}</a>
								<span>
									{repo.stars.toLocaleString('en-US')} stars · {repo.forks.toLocaleString('en-US')} forks
								</span>
							</>
						</li>
					))
				}
			</ul>
			<p class="mt-3 impact-disclosure">As of {dateLabel(github.asOf)}. {github.scope}</p>
		</section>
	</div>
	<p class="text-xs muted mt-5">
		GitHub contributions include qualifying commits, issues, pull requests, and reviews, not only commits. Counts are
		dated snapshots, not live counters.
	</p>
</div>

<style>
	.impact-disclosure {
		font-size: 12px;
		line-height: 1.7;
	}
	.impact-sources .impact-disclosure {
		margin-top: 12px;
	}
	details.impact-disclosure {
		margin-top: 12px;
	}
	.impact-disclosure summary {
		min-height: 32px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		list-style: none;
	}
	.impact-disclosure summary::-webkit-details-marker {
		display: none;
	}
	.impact-disclosure summary::after {
		content: '+';
	}
	.impact-disclosure[open] summary::after {
		content: '−';
	}
</style>
