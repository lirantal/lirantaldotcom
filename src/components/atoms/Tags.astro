---
import { getPermalink } from '~/utils/permalinks';

const { tags, class: className = 'text-sm' } = Astro.props;
---

{
	tags && Array.isArray(tags) && (
		<ul class={className}>
			{tags.map((tag) => (
				<li class="inline-block mr-2 mb-2">
					<a
						class="inline-block bg-gray-100 dark:bg-slate-700 py-1 px-2.5 hover:text-primary-700 dark:hover:text-primary-300"
						href={getPermalink(tag, 'tag')}
					>
						{tag}
					</a>
				</li>
			))}
		</ul>
	)
}
