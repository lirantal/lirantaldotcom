---
import { PROFILE } from '~/config.mjs';
import { Icon } from 'astro-icon/components';
import { getSocialShareLinks } from '~/utils/social-share.mjs';

const { title } = Astro.props;
const url = Astro.url;

const links = getSocialShareLinks(title, url, PROFILE.twitterHandle);
---

<div data-pagefind-ignore class="flex items-center justify-start gap-1 text-sm text-gray-500 dark:text-slate-400">
	<span class="mr-1">Share</span>
	{
		links.map((link) => (
			<a
				class="inline-flex items-center justify-center w-11 h-11 rounded-lg text-gray-500 hover:text-primary-700 hover:bg-gray-100 dark:text-slate-400 dark:hover:text-primary-300 dark:hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:focus-visible:outline-primary-300"
				href={link.href}
				aria-label={link.label}
				title={link.label}
			>
				<Icon name={link.icon} class="w-5 h-5" aria-hidden="true" />
			</a>
		))
	}
</div>
