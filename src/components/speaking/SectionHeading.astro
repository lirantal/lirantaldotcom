---
const { eyebrow, title, link, linkLabel, class: className = '' } = Astro.props;
---

<div class:list={['flex flex-wrap items-end justify-between gap-4 mb-8', className]}>
	<div>
		{eyebrow && <p class="speaking-label">{eyebrow}</p>}
		<h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight font-heading">{title}</h2>
	</div>
	{
		link && (
			<a href={link} class="text-sm font-semibold speaking-link">
				{linkLabel}
			</a>
		)
	}
</div>
