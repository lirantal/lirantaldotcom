---
import { Icon } from 'astro-icon/components';
import { SPEAKING } from '~/config.mjs';
import { BOOKING_YEAR, SPEAKING_BASE } from '~/utils/speaking';
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
	<div
		class="rounded-xl border border-gray-200 bg-gray-50 px-6 py-10 md:px-12 md:py-12 dark:border-slate-700 dark:bg-slate-800"
	>
		<div class="max-w-2xl">
			<p class="text-xs font-semibold tracking-[0.2em] uppercase text-primary-700 dark:text-primary-300">
				Booking {BOOKING_YEAR}
			</p>
			<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight font-heading">Tell me about your event.</h2>
			<p class="mt-4 text-lg text-gray-600 dark:text-slate-300">
				Conference keynote, meetup talk, workshop or podcast: send me the audience, the format and the dates, and I'll
				tailor a session to fit.
			</p>
		</div>
		<div class="mt-8 flex flex-wrap gap-3">
			<a class="btn text-white bg-primary-600 hover:bg-primary-800 shadow-none" href={SPEAKING.inviteURL}
				>Invite me to speak <span aria-hidden="true" class="ml-1">↗</span></a
			>
			<a
				class="btn text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 shadow-none dark:bg-slate-900 dark:text-slate-100 dark:border-slate-700 dark:hover:bg-slate-700"
				href={SPEAKING.inviteXURL}
			>
				<Icon name="tabler:brand-x" class="w-5 h-5 mr-2" aria-hidden="true" /> Message me on X
			</a>
			<a
				class="btn text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 shadow-none dark:bg-slate-900 dark:text-slate-100 dark:border-slate-700 dark:hover:bg-slate-700"
				href={`${SPEAKING_BASE}/talks`}>Browse the talks</a
			>
		</div>
	</div>
</section>
