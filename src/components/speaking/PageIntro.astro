---
/** Page header used by every speaking sub-page: eyebrow, headline, lede and optional actions/extras (default slot). */
const { eyebrow, title, highlight, description } = Astro.props;
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 md:pt-16 pb-8">
	<p class="speaking-label">
		{eyebrow}
	</p>
	<h1 class="mt-3 text-4xl md:text-6xl font-bold leading-tighter tracking-tighter font-heading max-w-4xl">
		{title}
		{
			highlight && (
				<span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-secondary-500">{highlight}</span>
			)
		}
	</h1>
	{description && <p class="mt-5 max-w-2xl speaking-lede">{description}</p>}
	<slot />
</section>
