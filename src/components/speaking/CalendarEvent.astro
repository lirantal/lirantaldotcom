---
import TypeBadge from '~/components/speaking/TypeBadge.astro';
import { formatDate, ordinalDay } from '~/utils/speaking';

/** Large-date row used for "next on the calendar" lists. */
const { event } = Astro.props;
const { day, suffix } = ordinalDay(event.date);
---

<li class="border-t border-gray-200 dark:border-slate-800 first:border-t-0">
	<a
		href={event.href}
		class="group grid grid-cols-[5rem_minmax(0,1fr)] sm:grid-cols-[6rem_minmax(0,1fr)_auto] gap-x-4 gap-y-2 py-5 items-start"
	>
		<time datetime={event.date.toISOString()} class="leading-none">
			<span class="text-4xl font-bold font-heading text-gray-900 dark:text-slate-100">{day}</span><sup
				class="text-sm font-semibold">{suffix}</sup
			>
			<span class="mt-1 block text-sm text-gray-500 dark:text-slate-400">{formatDate(event.date, 'monthYear')}</span>
		</time>
		<div>
			<h3 class="text-lg font-bold font-heading">
				<span
					class="text-primary-700 dark:text-primary-300 underline decoration-primary-300 dark:decoration-primary-700 underline-offset-4 group-hover:decoration-current"
					>{event.flag} {event.name}</span
				>
			</h3>
			<p class="mt-1 text-sm text-gray-600 dark:text-slate-400">
				{event.location}
				{event.title && <> · Talk: {event.title}</>}
			</p>
		</div>
		<div class="col-start-2 sm:col-start-auto flex gap-1.5">
			{
				event.upcoming ? (
					<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-green-700 dark:bg-green-800 text-white">
						Upcoming
					</span>
				) : (
					<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-700 dark:bg-slate-800 dark:text-slate-300">
						Recently
					</span>
				)
			}
			<TypeBadge type={event.type} />
		</div>
	</a>
</li>
