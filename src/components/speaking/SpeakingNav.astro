---
import { SPEAKING } from '~/config.mjs';
import { SPEAKING_BASE } from '~/utils/speaking';

const links = [
	{ href: SPEAKING_BASE, label: 'Overview' },
	{ href: `${SPEAKING_BASE}/talks`, label: 'Talks' },
	{ href: `${SPEAKING_BASE}/events`, label: 'Events' },
	{ href: `${SPEAKING_BASE}/recordings`, label: 'Recordings' },
	{ href: `${SPEAKING_BASE}/podcasts`, label: 'Podcasts' },
	{ href: `${SPEAKING_BASE}/press-kit`, label: 'Press kit' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => (href === SPEAKING_BASE ? path === href : path.startsWith(href));
---

<nav aria-label="Speaking" class="border-b border-gray-200 dark:border-slate-800">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center gap-1 py-2 overflow-x-auto">
		<span
			class="hidden sm:inline text-xs font-semibold tracking-[0.2em] uppercase text-gray-500 dark:text-slate-400 mr-3"
			>Speaking</span
		>
		{
			links.map((link) => (
				<a
					href={link.href}
					aria-current={isActive(link.href) ? 'page' : undefined}
					class:list={[
						"relative rounded-full px-3 py-1 text-sm font-medium whitespace-nowrap transition after:absolute after:inset-x-0 after:-inset-y-2 after:content-['']",
						isActive(link.href)
							? 'bg-primary-600 text-white'
							: 'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white',
					]}
				>
					{link.label}
				</a>
			))
		}
		<a
			href={SPEAKING.inviteURL}
			class="relative ml-auto rounded-full px-3 py-1 text-sm after:absolute after:inset-x-0 after:-inset-y-2 after:content-[''] font-semibold whitespace-nowrap text-primary-700 hover:bg-primary-50 dark:text-primary-300 dark:hover:bg-slate-800"
			>Invite me <span aria-hidden="true">↗</span></a
		>
	</div>
</nav>
