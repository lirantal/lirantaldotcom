---
import { Icon } from 'astro-icon/components';
import { SPEAKING } from '~/config.mjs';
import { SPEAKING_BASE } from '~/utils/speaking';

const links = [
	{ href: SPEAKING_BASE, label: 'Overview' },
	{ href: `${SPEAKING_BASE}/talks`, label: 'Talks' },
	{ href: `${SPEAKING_BASE}/events`, label: 'Events' },
	{ href: `${SPEAKING_BASE}/recordings`, label: 'Recordings' },
	{ href: `${SPEAKING_BASE}/podcasts`, label: 'Podcasts' },
	{ href: `${SPEAKING_BASE}/press-kit`, label: 'Press kit' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => (href === SPEAKING_BASE ? path === href : path.startsWith(href));
---

<nav aria-label="Speaking" class="speaking-nav border-b border-gray-200 dark:border-slate-800">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center gap-1 overflow-x-auto">
		<span class="hidden sm:inline speaking-label mr-3">Speaking</span>
		{
			links.map((link) => (
				<a
					href={link.href}
					aria-current={isActive(link.href) ? 'page' : undefined}
					class:list={[
						'relative border-b-2 px-3 py-3 text-sm font-medium whitespace-nowrap transition-colors',
						isActive(link.href) ? 'speaking-nav-current' : 'border-transparent speaking-muted hover:border-gray-400',
					]}
				>
					{link.label}
				</a>
			))
		}
		<a
			href={SPEAKING.inviteURL}
			class="relative ml-auto px-3 py-3 text-sm font-semibold whitespace-nowrap speaking-link"
			>Invite me <Icon name="tabler:arrow-up-right" class="inline-block w-4 h-4 align-middle" aria-hidden="true" /></a
		>
	</div>
</nav>
