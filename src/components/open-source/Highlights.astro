---
import { Icon } from 'astro-icon/components';
import { openSourceHighlights } from '~/data/open-source';
interface Props {
	entries?: typeof openSourceHighlights;
}
const { entries = openSourceHighlights } = Astro.props;
---

<div class="oss-highlights">
	{
		entries.map((highlight) => (
			<article>
				<h3>
					<a href={highlight.href}>
						{highlight.icon && <Icon name={highlight.icon} class="oss-highlight-logo" aria-hidden="true" />}
						<span>{highlight.title}</span>
					</a>
				</h3>
				<p>{highlight.text}</p>
			</article>
		))
	}
</div>

<style>
	.oss-highlights {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px;
	}
	.oss-highlights article {
		padding-block: 12px;
	}
	.oss-highlights h3 {
		font-size: 18px;
	}
	.oss-highlights a {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		max-width: 100%;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.oss-highlights a span {
		min-width: 0;
	}
	.oss-highlights .oss-highlight-logo {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
	}
	.oss-highlights p {
		margin-top: 12px;
		font-size: 14px;
		color: var(--muted);
		max-width: 38ch;
	}
	@media (max-width: 760px) {
		.oss-highlights {
			grid-template-columns: 1fr;
			gap: 12px;
		}
		.oss-highlights p {
			max-width: 65ch;
		}
	}
</style>
