---
import { Icon } from 'astro-icon/components';
import { openSourceHighlights } from '~/data/open-source';
import ProjectImpact from './ProjectImpact.astro';
interface Props {
	entries?: typeof openSourceHighlights;
}
const { entries = openSourceHighlights } = Astro.props;
---

<div class="oss-highlights">
	{
		entries.map((highlight) => (
			<article>
				<h3>
					<a href={highlight.href}>
						{highlight.icon && <Icon name={highlight.icon} class="oss-highlight-logo" aria-hidden="true" />}
						<span>{highlight.title}</span>
					</a>
				</h3>
				{highlight.items || highlight.textIcon ? (
					<ul class="oss-highlight-items" role="list">
						{[{ text: highlight.text, icon: highlight.textIcon, href: undefined }, ...(highlight.items || [])].map(
							(item) => (
								<li>
									{item.icon && <Icon name={item.icon} class="oss-highlight-item-icon" aria-hidden="true" />}
									{item.href ? <a href={item.href}>{item.text}</a> : <span>{item.text}</span>}
								</li>
							)
						)}
					</ul>
				) : (
					<p>{highlight.text}</p>
				)}
				{highlight.projectURL && <ProjectImpact url={highlight.projectURL} name={highlight.title} />}
			</article>
		))
	}
</div>

<style>
	.oss-highlights {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px;
	}
	.oss-highlights article {
		padding-block: 12px;
	}
	.oss-highlights h3 {
		font-size: 18px;
	}
	.oss-highlights a {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		max-width: 100%;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.oss-highlights a span {
		min-width: 0;
	}
	.oss-highlights .oss-highlight-logo {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
	}
	.oss-highlights p {
		margin-top: 12px;
		font-size: 14px;
		color: var(--muted);
		max-width: 38ch;
	}
	.oss-highlight-items {
		display: grid;
		gap: 12px;
		margin-top: 12px;
		padding: 0;
		list-style: none;
		font-size: 14px;
		color: var(--muted);
		max-width: 38ch;
	}
	.oss-highlight-items li {
		display: flex;
		align-items: flex-start;
		gap: 8px;
	}
	.oss-highlight-items .oss-highlight-item-icon {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		margin-top: 4px;
	}
	@media (max-width: 760px) {
		.oss-highlights {
			grid-template-columns: 1fr;
			gap: 12px;
		}
		.oss-highlights p,
		.oss-highlight-items {
			max-width: 65ch;
		}
	}
</style>
