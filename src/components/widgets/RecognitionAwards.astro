---
import { Picture } from 'astro:assets';
import githubStars from '~/assets/images/lirantal-github-stars-award.jpg';
import openjsAward from '~/assets/images/lirantal-openjs-foundation-security-award.jpg';
import schrodingerAward from '~/assets/images/lirantal-schrodinger-award.jpg';

const awards = [
	{
		title: 'GitHub Stars award',
		image: githubStars,
		alt: 'Liran Tal’s GitHub Stars award',
		description:
			'GitHub Stars are a diverse set of individuals that inspire, educate, and influence those around them. They are nominated by GitHub as experts and technical leaders who passionately share their expertise with others.',
		href: 'https://stars.github.com/alumni',
		label: 'About GitHub Stars',
	},
	{
		title: 'OpenJS Foundation Pathfinder award for Security',
		image: openjsAward,
		alt: 'Liran Tal’s OpenJS Foundation Security award',
		quote:
			'Liran is a tireless advocate for security in the JS ecosystem. He works hard to build bridges, educate developers about security issues, and support Open Source projects working to improve their security posture. Liran has served on the Node security team and is always available to support developers!',
		href: 'https://openjsf.org/blog/openjs-world-2022-heres-what-you-missed',
		label: 'Read the OpenJS announcement',
	},
	{
		title: 'Schrodinger Open Source Day award',
		image: schrodingerAward,
		alt: 'Liran Tal’s Schrodinger Open Source Day award',
		description:
			'Liran Tal delivered the opening keynote at the OpenSourceDay 2023 event in Italy and was honored to receive the Schrodinger Open Source Day award.',
		href: 'https://osday.dev/',
		label: 'About Open Source Day',
	},
];
---

<section class="recognition-awards" aria-labelledby="awards-heading">
	<h2 id="awards-heading" class="mb-6">01 / Awards</h2>
	<div class="grid gap-8 md:grid-cols-3">
		{
			awards.map((award) => (
				<article class="flex min-w-0 flex-col">
					<Picture
						src={award.image}
						alt={award.alt}
						widths={[320, 640, 960]}
						sizes="(min-width: 1152px) 347px, (min-width: 768px) calc((100vw - 112px) / 3), calc(100vw - 40px)"
						width={640}
						class="award-photo mb-5 w-full rounded-xl"
						loading="eager"
					/>
					<h3 class="mb-3">{award.title}</h3>
					{award.quote ? (
						<figure class="mb-5">
							<blockquote class="text-sm leading-relaxed">“{award.quote}”</blockquote>
							<figcaption class="muted mt-3 text-sm">— The OpenJS Foundation</figcaption>
						</figure>
					) : (
						<p class="muted mb-5 text-sm leading-relaxed">{award.description}</p>
					)}
					<a class="mt-auto text-sm" href={award.href}>
						{award.label} ↗︎
					</a>
				</article>
			))
		}
	</div>
</section>

<style>
	.award-photo {
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
</style>
