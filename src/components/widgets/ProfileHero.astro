---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { PROFILE } from '~/config.mjs';
import portrait from '~/assets/images/liran-tal-portrait-cutout.png';
---

<section class="refined-intro forma-wrap" aria-labelledby="refined-title">
	<div class="refined-introduction">
		<h1 id="refined-title">Securing the<br />agentic future.</h1>
		<p class="forma-lede">
			I research emerging threats and build open-source defenses for AI agents, the software they write, and the tools
			they trust.
		</p>
		<p class="forma-role">
			Software engineer, security researcher, and open-source maintainer.<br />Leading Developer Relations at <a
				href="https://snyk.io/">Snyk</a
			>.
		</p>
		<div class="forma-actions">
			<a class="forma-button" href="/research">Explore my research</a><a
				class="forma-button forma-button-secondary"
				href={'/writing'}>Read the blog</a
			>
		</div>
		<div class="forma-small-actions hero-action-links">
			<a href="/hire-me">Hire me</a>
			<span
				><span class="hero-action-separator" aria-hidden="true">/</span><a href="/speaking">Invite me to speak</a></span
			>
			<span
				><span class="hero-action-separator" aria-hidden="true">/</span><a href="/speaking/press-kit">Bio & press kit</a
				></span
			>
		</div>
	</div>
	<div class="refined-profile">
		<Picture
			class="refined-portrait"
			src={portrait}
			alt="Liran Tal"
			width={660}
			widths={[220, 320, 440, 660, 960]}
			sizes="(max-width:760px) 220px, (max-width:1050px) 280px, 320px"
			formats={['avif', 'webp']}
			fallbackFormat="webp"
			quality={45}
			loading="eager"
			fetchpriority="high"
		/>
		<nav class="refined-socials" aria-label="Social profiles">
			<a class="refined-social-x" href={PROFILE.twitterURL} aria-label="X / Twitter" title="X / Twitter"
				><Icon name="tabler:brand-x" aria-hidden="true" /></a
			>
			<a href={PROFILE.githubURL} aria-label="GitHub" title="GitHub"
				><Icon name="tabler:brand-github" aria-hidden="true" /></a
			>
			<a href={PROFILE.linkedinURL} aria-label="LinkedIn" title="LinkedIn"
				><Icon name="tabler:brand-linkedin" aria-hidden="true" /></a
			>
		</nav>
	</div>
</section>
