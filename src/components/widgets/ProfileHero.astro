---
import { Image } from 'astro:assets';
import portrait from '~/assets/images/liran-tal-portrait.jpg';
import { PROFILE } from '~/config.mjs';
---

<section class="pt-12 pb-10 md:pt-20 md:pb-14" aria-labelledby="intro-title">
	<div class="flex flex-col-reverse md:flex-row gap-8 md:gap-16 items-start md:items-center">
		<div class="flex-1">
			<p class="eyebrow flex flex-wrap gap-x-6 gap-y-2">
				<span>Security researcher</span><span>Author</span><span>Open-source maintainer</span>
			</p>
			<h1 id="intro-title">Hi, I’m <span class="text-primary-600 dark:text-primary-400">Liran Tal.</span></h1>
			<p class="mt-5 text-xl md:text-2xl max-w-2xl leading-relaxed muted">
				I help developers build secure software,<br />from Node.js to <span class="whitespace-nowrap">AI agents.</span>
			</p>
			<p class="mt-3 text-lg muted">I research, write, and build tools in the open.</p>
			<p class="mt-4 text-sm muted">
				Developer Relations at <a href="https://snyk.io/contributors/liran-tal/">Snyk</a>
			</p>
			<div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium">
				<a href="/writing">Read my writing →</a>
				<a href="/speaking">Invite me to speak →</a>
				<a href="/speaking/press-kit">Bio & press kit →</a>
			</div>
		</div>
		<div class="shrink-0 flex flex-col items-center gap-5">
			<Image
				src={portrait}
				alt="Liran Tal"
				width={208}
				height={208}
				widths={[208, 416]}
				sizes="208px"
				loading="eager"
				fetchpriority="high"
				class="rounded-full w-28 h-28 md:w-52 md:h-52 object-cover"
			/>
			<div class="flex gap-6 text-sm">
				<a href={PROFILE.githubURL}>GitHub ↗</a>
				<a href={PROFILE.linkedinURL}>LinkedIn ↗</a>
			</div>
		</div>
	</div>
	<div class="mt-10 pt-6 border-t border-gray-200 dark:border-slate-700 flex flex-wrap gap-x-7 gap-y-3 text-sm muted">
		<a href="https://stars.github.com/profiles/lirantal/">GitHub Star</a>
		<a href="/recognitions">OpenJS Security Pathfinder</a>
	</div>
</section>
