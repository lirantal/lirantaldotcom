---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import portrait from '~/assets/images/liran-tal-portrait.jpg';
import { PROFILE } from '~/config.mjs';
---

<section class="pt-12 pb-10 md:pt-20 md:pb-14" aria-labelledby="intro-title">
	<div class="flex flex-col-reverse md:flex-row gap-8 md:gap-16 items-start md:items-center">
		<div class="flex-1">
			<p class="eyebrow overflow-hidden">
				<!-- Clip the leading separator on each wrapped row, keeping dots only between roles. -->
				<span class="flex flex-wrap -ml-12 gap-y-2">
					{
						['Security researcher', 'Author', 'Open-source maintainer'].map((role) => (
							<span class="inline-flex whitespace-nowrap">
								<span class="w-12 shrink-0 text-center" aria-hidden="true">
									·
								</span>
								{role}
							</span>
						))
					}
				</span>
			</p>
			<h1 id="intro-title">Hi, I’m <span class="text-primary-600 dark:text-primary-400">Liran Tal.</span></h1>
			<p class="mt-5 text-xl md:text-2xl max-w-2xl leading-relaxed muted">
				I help developers build secure software,<br />from Node.js to <span class="whitespace-nowrap">AI agents.</span>
				I research, write, and build tools in the open.
			</p>
			<div class="mt-6 text-sm font-medium">
				<p class="muted">I head Developer Relations at <a href="https://snyk.io/contributors/liran-tal/">Snyk</a></p>
				<div class="mt-2 flex flex-wrap gap-x-6 gap-y-3">
					<a href="/writing">Read my writing →</a>
					<a href="/speaking">Invite me to speak →</a>
					<a href="/speaking/press-kit">Bio & press kit →</a>
				</div>
			</div>
		</div>
		<div class="shrink-0 flex flex-col items-center gap-5">
			<Image
				src={portrait}
				alt="Liran Tal"
				width={208}
				height={208}
				widths={[208, 416]}
				sizes="208px"
				loading="eager"
				fetchpriority="high"
				class="rounded-full w-28 h-28 md:w-52 md:h-52 object-cover"
			/>
			<div class="flex items-center gap-3">
				<a
					href={PROFILE.twitterURL}
					aria-label="X / Twitter"
					title="X / Twitter"
					class="inline-flex items-center justify-center w-11 h-11"
				>
					<Icon name="tabler:brand-x" class="w-6 h-6" aria-hidden="true" />
				</a>
				<a
					href={PROFILE.githubURL}
					aria-label="GitHub"
					title="GitHub"
					class="inline-flex items-center justify-center w-11 h-11"
				>
					<Icon name="tabler:brand-github" class="w-6 h-6" aria-hidden="true" />
				</a>
				<a
					href={PROFILE.linkedinURL}
					aria-label="LinkedIn"
					title="LinkedIn"
					class="inline-flex items-center justify-center w-11 h-11"
				>
					<Icon name="tabler:brand-linkedin" class="w-6 h-6" aria-hidden="true" />
				</a>
			</div>
		</div>
	</div>
	<div
		class="mt-10 pt-6 border-t border-gray-200 dark:border-slate-700 flex flex-col sm:flex-row gap-x-7 gap-y-3 text-sm muted"
	>
		<span class="font-medium shrink-0">Industry recognition</span>
		<div class="flex flex-wrap gap-x-7 gap-y-3">
			<a href="https://stars.github.com/profiles/lirantal/">GitHub Star</a>
			<a href="/recognitions">OpenJS Security Pathfinder</a>
		</div>
	</div>
</section>
