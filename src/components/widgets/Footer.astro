---
import { Icon } from 'astro-icon/components';
import { FOOTER, PROFILE } from '~/config.mjs';
const currentYear = new Date().getFullYear();
const social = [
	['RSS', '/rss.xml', 'tabler:rss'],
	['X / Twitter', PROFILE.twitterURL, 'tabler:brand-x'],
	['GitHub', PROFILE.githubURL, 'tabler:brand-github'],
	['LinkedIn', PROFILE.linkedinURL, 'tabler:brand-linkedin'],
	['Mastodon', PROFILE.mastodonURL, 'mdi:mastodon'],
];
---

<footer class="forma-footer">
	<div class="forma-wrap">
		<div class="forma-subscribe">
			<div>
				<h2>Get new articles.</h2><p>
					AI security, Node.js, and the software supply chain.<br />Follow the blog in your feed reader.
				</p>
			</div><a class="forma-button" href="/rss.xml"><Icon name="tabler:rss" aria-hidden="true" />Follow via RSS</a>
		</div>
		<div class="site-footer-columns">
			<div>
				<a class="forma-brand" href="/">Liran Tal</a><nav aria-label="About this site">
					<a href="/hire-me">Hire me</a><a href="/recognitions">Recognitions</a><a href="/about">About</a><a
						href="/contact">Contact</a
					><a href="/developers">Developers</a><a href="/privacy">Privacy</a>
				</nav>
			</div>
			{
				FOOTER.columns.map((column) => (
					<div>
						<>
							<h3>{column.title}</h3>
							<ul>
								{column.items.map((item) => (
									<li>
										<a href={item.link}>{item.title}</a>
									</li>
								))}
							</ul>
						</>
					</div>
				))
			}
		</div>
		<div class="forma-footer-bottom">
			<p>© {currentYear} Liran Tal</p><nav class="footer-socials" aria-label="Social profiles">
				{
					social.map(([name, url, icon]) => (
						<a href={url} aria-label={name} title={name} rel={name === 'Mastodon' ? 'me' : undefined}>
							<Icon name={icon} aria-hidden="true" />
						</a>
					))
				}
			</nav>
		</div>
	</div>
</footer>
