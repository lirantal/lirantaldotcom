---
import { Picture } from 'astro:assets';
import nodejsBookCover from '~/assets/images/nodejs-secure-coding-book-3d-style.png';
---

<section class="body-font">
	<div
		class="max-w-2xl mx-auto px-6 py-12 flex flex-col-reverse sm:flex-row items-center gap-8"
	>
		<div class="flex-1 text-center sm:text-left">
			<p class="mb-6 text-lg leading-relaxed">
				Liran Tal is the author of the book <a
					class="font-medium text-primary-700 underline decoration-primary-700/40 underline-offset-2 hover:decoration-primary-700 dark:text-primary-300 dark:decoration-primary-300/40 dark:hover:decoration-primary-300"
					href="https://www.nodejs-security.com/"
					target="_blank"
				>
					Node.js Secure Coding: Defending Against Command Injection Vulnerabilities
				</a>
			</p>
			<a
				class="btn text-white bg-primary-600 hover:bg-primary-800 shadow-none rounded-lg px-5 py-2.5"
				href="https://www.nodejs-security.com/"
				target="_blank"
				>Start Building Secure Node.js Applications <span aria-hidden="true" class="ml-1">↗</span>
			</a>
		</div>
		<a href="https://www.nodejs-security.com/" target="_blank" tabindex="-1" aria-hidden="true" class="shrink-0">
			<Picture
				class="w-32 sm:w-36 h-auto"
				widths={[160, 320]}
				sizes="144px"
				loading="lazy"
				alt=""
				src={nodejsBookCover}
			/>
		</a>
	</div>
</section>
