<!-- Pagefind assets load only on pages that render search, not site-wide. -->
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js" defer></script>

<div id="search" class="mb-10 max-w-2xl"></div>

<script>
	window.addEventListener('DOMContentLoaded', () => {
		new PagefindUI({ element: '#search', resetStyles: false });
	});
</script>

<style is:global>
	/* Reserve Pagefind's scaled input height before its deferred script runs. */
	#search {
		--pagefind-ui-scale: 0.8;
		min-height: calc(64px * var(--pagefind-ui-scale));
		--pagefind-ui-font: 'Inter', ui-sans-serif, system-ui, sans-serif;
		--pagefind-ui-primary: var(--ink);
		--pagefind-ui-text: var(--ink);
		--pagefind-ui-background: var(--paper);
		--pagefind-ui-border: var(--rule);
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 6px;
		--pagefind-ui-tag: var(--surface);
	}
	#search .pagefind-ui {
		--pagefind-ui-scale: inherit;
	}
	#search .pagefind-ui__search-input {
		font-weight: 400;
	}
	#search .pagefind-ui__search-input::placeholder {
		color: var(--muted);
		opacity: 1;
	}
	#search .pagefind-ui__search-input:focus-visible {
		outline: 2px solid var(--pagefind-ui-primary);
		outline-offset: 3px;
	}
	#search .pagefind-ui__result-link {
		color: var(--pagefind-ui-primary);
		text-decoration: underline;
		text-underline-offset: 0.23em;
	}
	.dark #search .pagefind-ui__search-input::placeholder {
		color: var(--color-slate-400);
	}
	.dark #search {
		--pagefind-ui-primary: var(--ink);
		--pagefind-ui-text: var(--color-slate-300);
		--pagefind-ui-background: var(--color-slate-800);
		--pagefind-ui-border: var(--color-slate-700);
		--pagefind-ui-tag: var(--color-slate-700);
	}
	.dark #search .pagefind-ui__result-link {
		color: var(--ink);
	}
	.dark #search mark {
		color: var(--color-slate-900);
		background-color: var(--ink);
	}
</style>
