---
import { NAVIGATION } from '~/config.mjs';
import Logo from '~/components/atoms/Logo.astro';
import ToggleTheme from '~/components/core/ToggleTheme.astro';
import ToggleMenu from '~/components/core/ToggleMenu.astro';
import { getHomePermalink } from '~/utils/permalinks';

const path = Astro.url.pathname.replace(/\/$/, '');
---

<header
	class="sticky top-0 z-40 mx-auto w-full bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm border-b border-gray-200 dark:border-slate-800"
>
	<div class="py-3 px-4 mx-auto w-full lg:flex lg:justify-between max-w-6xl">
		<div class="flex justify-between">
			<a class="flex items-center" href={getHomePermalink()}><Logo /></a>
			<div class="flex items-center lg:hidden"><ToggleTheme /><ToggleMenu /></div>
		</div>
		<nav
			class="items-center w-full lg:w-auto hidden lg:flex text-gray-600 dark:text-slate-300 max-h-[calc(100dvh-5rem)] overflow-y-auto"
			aria-label="Main navigation"
			id="menu"
		>
			<ul class="flex flex-col py-4 lg:py-0 lg:flex-row w-full lg:w-auto text-lg lg:text-sm">
				{
					NAVIGATION.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={
									!link.href.includes('#') &&
									(path === link.href ||
										path.startsWith(`${link.href}/`) ||
										(link.href === '/writing' && (path === '/blog' || path.startsWith('/blog/'))))
										? 'page'
										: undefined
								}
								class="font-medium hover:text-primary-700 dark:hover:text-primary-300 aria-[current=page]:text-primary-700 dark:aria-[current=page]:text-primary-300 px-3 py-3 flex items-center focus-visible:outline-2 focus-visible:outline-primary-500 focus-visible:-outline-offset-2"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<div class="hidden lg:flex items-center ml-3">
				<ToggleTheme iconClass="w-5 h-5" />
			</div>
		</nav>
	</div>
</header>
