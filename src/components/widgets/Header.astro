---
import { NAVIGATION } from '~/config.mjs';
import ToggleTheme from '~/components/core/ToggleTheme.astro';
import ToggleMenu from '~/components/core/ToggleMenu.astro';
const path = Astro.url.pathname.replace(/\/$/, '');
const active = (href: string) =>
	!href.includes('#') &&
	(path === href ||
		path.startsWith(`${href}/`) ||
		(href === '/writing' && (path === '/blog' || path.startsWith('/blog/'))));
---

<header class="site-header">
	<div class="forma-wrap site-header-inner">
		<div class="site-brand-row">
			<a class="forma-brand" href="/">Liran Tal</a><div class="flex items-center lg:hidden">
				<ToggleTheme /><ToggleMenu />
			</div>
		</div>
		<nav id="menu" class="hidden lg:flex" aria-label="Main navigation">
			<ul>
				{
					NAVIGATION.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={active(link.href) ? 'page' : undefined}
								class:list={[
									{
										'forma-button forma-button-small': link.href === '/writing',
										'hire-link': link.href === '/hire-me',
									},
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<div class="hidden lg:flex"><ToggleTheme iconClass="w-5 h-5" /></div>
		</nav>
	</div>
</header>
