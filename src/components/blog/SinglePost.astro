---
import { Image } from 'astro:assets';
import Picture from '~/components/core/Picture.astro';
import PostTags from '~/components/atoms/Tags.astro';
import SocialShare from '~/components/atoms/SocialShare.astro';
import { getFormattedDate } from '~/utils/utils';
import portrait from '~/assets/images/liran-tal-portrait-cutout.png';
const { post } = Astro.props;
const Content = post.Content;
const date = new Date(post.pubDate);
const dateTime = post.pubDate && Number.isFinite(date.getTime()) ? date.toISOString() : undefined;
---

<section class="forma-reading-page forma-wrap">
	<article class="forma-article" data-pagefind-body>
		<header>
			<a href="/writing">Back to Blog</a><p class="forma-meta">
				{dateTime && <time datetime={dateTime}>{getFormattedDate(post.pubDate)}</time>}{dateTime ? ' · ' : ''}{
					post.readingTime
				}
			</p>
			<h1>{post.title}</h1><p class="forma-lede">{post.description}</p>
			<div class="forma-byline"><Image src={portrait} alt="" width={44} height={44} /><span>By Liran Tal</span></div>
			<div class="mt-5"><PostTags tags={post.tags} /><SocialShare {...post} /></div>
		</header>
		{
			post.image && (
				<Picture
					class="forma-article-cover"
					src={post.image}
					alt={`Cover artwork for ${post.title}`}
					widths={[360, 480, 640, 768, 960, 1200]}
					sizes="(max-width:760px) calc(100vw - 40px), (max-width:1016px) calc(100vw - 56px), 960px"
					loading="eager"
					fetchpriority="high"
				/>
			)
		}
		<div class="reading-body prose dark:prose-invert">{Content ? <Content /> : <Fragment set:html={post.body} />}</div>
	</article>
</section>
<script>
	import '~/scripts/mermaid-post-client';
</script>
