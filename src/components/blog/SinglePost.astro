---
import Picture from '~/components/core/Picture.astro';
import PostTags from '~/components/atoms/Tags.astro';
import SocialShare from '~/components/atoms/SocialShare.astro';

import { getFormattedDate } from '~/utils/utils';

const { post } = Astro.props;
const Content = post.Content;
---

<section class="py-4 sm:py-4 lg:py-4 mx-auto">
	<article data-pagefind-body>
		<header class="max-w-6xl mx-auto px-5 sm:px-6 pt-8 sm:pt-12">
			<p class="text-sm text-gray-600 dark:text-slate-400 mb-3">
				<time datetime={post.pubDate}>{getFormattedDate(post.pubDate)}</time> ~ {post.readingTime}
			</p>
			<h1 class="max-w-4xl text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
				{post.title}
			</h1>

			<div class="mt-5 mb-2">
				<PostTags tags={post.tags} />
			</div>
			<SocialShare {...post} />

			{
				post.image && (
					<Picture
						src={post.image}
						class="w-full mt-6 mb-6 rounded-md bg-gray-400 dark:bg-slate-700"
						widths={[480, 900, 1200]}
						sizes="(max-width: 1152px) calc(100vw - 48px), 1104px"
						alt={post.description}
						aspectRatio="16:9"
						loading="eager"
						fetchpriority="high"
					/>
				)
			}
		</header>
		<div
			class="mx-auto px-6 sm:px-6 max-w-2xl prose prose-lg dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary-700 dark:prose-a:text-primary-300 prose-img:rounded-md prose-img:shadow-lg mt-8"
		>
			{Content ? <Content /> : <Fragment set:html={post.body} />}
		</div>
	</article>
</section>

<script>
	import '~/scripts/mermaid-post-client';
</script>
