---
import Layout from '~/layouts/PageLayout.astro';

const { meta } = Astro.props;
---

<Layout {meta}>
	<div class="blog-archive">
		<section class="px-5 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-6xl">
			<header>
				<h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-8 md:mb-10 font-heading">
					<slot name="title" />
				</h1>
			</header>
			<slot />
		</section>
	</div>
</Layout>
