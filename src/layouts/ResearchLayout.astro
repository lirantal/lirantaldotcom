---
import PageLayout from '~/layouts/PageLayout.astro';
import { researchPages } from '~/data/research';
import '~/assets/styles/portfolio.css';

const { meta } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
	{ href: '/research', label: 'Overview' },
	...researchPages.map((page) => ({
		href: `/research/${page.slug}`,
		label: page.label,
	})),
];
---

<PageLayout {meta}>
	<nav aria-label="Research" class="border-b border-gray-200 dark:border-slate-800">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-wrap gap-x-1">
			{
				links.map((link) => (
					<a
						href={link.href}
						aria-current={path === link.href ? 'page' : undefined}
						class:list={[
							'border-b-2 px-3 py-3 text-sm font-medium whitespace-nowrap focus-visible:outline-2 focus-visible:outline-primary-600 focus-visible:-outline-offset-2 dark:focus-visible:outline-primary-300',
							path === link.href
								? 'border-primary-600 text-primary-700 dark:border-primary-300 dark:text-primary-300'
								: 'border-transparent text-gray-600 hover:border-gray-400 hover:text-gray-900 dark:text-slate-300 dark:hover:text-slate-100',
						]}
					>
						{link.label}
					</a>
				))
			}
		</div>
	</nav>
	<div class="portfolio research pb-16">
		<slot />
	</div>
</PageLayout>

<style is:global>
	.research {
		overflow-wrap: anywhere;
	}
	.research .research-intro {
		padding-block: 3.5rem 2.5rem;
	}
	.research .research-intro h1 {
		max-width: 17ch;
		text-wrap: balance;
	}
	.research .research-intro .lede {
		max-width: 65ch;
		margin-top: 1.5rem;
		font-size: 1.15rem;
		color: var(--ink-muted);
	}
	.research .research-copy {
		max-width: 68ch;
	}
	.research .research-copy p + p {
		margin-top: 1rem;
	}
	.research .research-metrics {
		border-block: 1px solid var(--line);
		font-variant-numeric: tabular-nums;
	}
	.research .research-metrics > div {
		display: flex;
		flex-direction: column;
		padding-block: 1.5rem;
	}
	.research .research-metrics dd {
		order: -1;
		font-size: 2.75rem;
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.035em;
	}
	.research .research-metrics dt {
		margin-top: 0.65rem;
	}
	.research .research-metrics p {
		font-size: 0.8rem;
		margin-top: 0.3rem;
	}
	.research .research-facts dt {
		font-size: 0.75rem;
		color: var(--ink-muted);
	}
	.research .research-facts dd {
		margin-top: 0.25rem;
		font-weight: 500;
	}
	.research .research-facts > div + div {
		margin-top: 1.25rem;
	}
	.research .source-links li + li {
		margin-top: 0.75rem;
	}
	@media (max-width: 639px) {
		.research .section-heading > div {
			flex: initial;
		}
	}
</style>
