{
  "name": "lirantaldotcom",
  "description": "Liran Tal's personal website and blog",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 3001",
    "start": "npm run build && astro preview",
    "build": "astro build && sh scripts/postbuild.sh",
    "postbuild": "sh scripts/postbuild.sh",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier -w .",
    "lint": "eslint .",
    "lint:eslint": "eslint .",
    "blog:cover": "node scripts/generate-blog-cover.js",
    "blog:compress-images": "node scripts/compress-large-blog-images.mjs",
    "subfont": "if [ -d dist/client ]; then subfont -ir --no-fallbacks --silent --root dist/client; else subfont -ir --no-fallbacks --silent --root dist; fi"
  },
  "devDependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.6",
    "@tailwindcss/vite": "^4.2.4",
    "@astrolib/analytics": "^0.6.1",
    "@astrolib/seo": "1.0.0-beta.8",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@iconify-json/emojione": "^1.2.3",
    "@iconify-json/logos": "^1.2.9",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.33",
    "@tailwindcss/typography": "^0.5.19",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "astro": "^6.2.1",
    "astro-embed": "^0.13.0",
    "astro-icon": "^1.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "flowbite": "^4.0.1",
    "globals": "^17.6.0",
    "limax": "^4.2.3",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "^0.34.5",
    "subfont": "^7.2.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "unist-util-visit": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@astrojs/solid-js": "^6.0.1",
    "@vercel/analytics": "^2.0.1",
    "mermaid": "^11.14.0",
    "solid-js": "^1.9.10",
    "pagefind": "^1.5.2"
  }
}
