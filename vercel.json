{
  "build": {
    "env": {
      "NODE_VERSION": "24.x"
    }
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/games-chatgpt-chat-meme-generator",
      "destination": "/games/chatgpt-chat-meme-generator",
      "permanent": true
    },
    {
      "source": "/games-chatgpt-security-models-ui",
      "destination": "/games/chatgpt-security-models-ui",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </.well-known/site-for-agents.json>; rel=\"describedby\", </rss.xml>; rel=\"service-desc\", </docs/agents.md>; rel=\"service-doc\""
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}
