{
  "cleanUrls": true,
  "redirects": [
    { "source": "/games-chatgpt-chat-meme-generator", "destination": "/games/chatgpt-chat-meme-generator", "permanent": true },
    { "source": "/games-chatgpt-security-models-ui", "destination": "/games/chatgpt-security-models-ui", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}